includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - tests
    level: 0
    scanFiles:
        - stubs/phpstan/ScribeAttributes.php
    tmpDir: storage/phpstan
    bootstrapFiles:
        - tools/phpstan/bootstrap.php
    parallel:
        maximumNumberOfProcesses: 1
        processTimeout: 2400.0

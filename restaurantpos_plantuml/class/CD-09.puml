@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563

hide empty methods
skinparam classAttributeIconSize 0
left to right direction
title CD-09 - Conversation, Notification và Support
caption Mô tả aggregate conversation nội bộ, assignment, message, file, event, analysis và nền tảng\nnotification outbox.
skinparam class {
  BackgroundColor white
  BorderColor #374151
  ArrowColor #4B5563
  HeaderBackgroundColor #E5EEF9
}

class "User" as User <<entity>> {
  {static} table = users
  --
  user_id
  role_id
  current_tier_id
  row_version
  privacy_anonymized_at
  username
  full_name
}

class "Reservation" as Reservation <<entity>> {
  {static} table = reservations
  --
  reservation_id
  user_id
  applied_user_voucher_id
  row_version
  status
  deposit_status
  deposit_intent_status
}

class "WaitingList" as WaitingList <<entity>> {
  {static} table = waiting_list
  --
  waiting_id
  user_id
  customer_session_id
  row_version
  status
  customer_response_status
  branch_id
}

class "Conversation" as Conversation <<entity>> {
  {static} table = conversations
  --
  conversation_id
  branch_id
  user_id
  linked_reservation_id
  linked_waiting_list_id
  customer_session_id
  session_id
}

class "AgentAssignment" as AgentAssignment <<entity>> {
  {static} table = agent_assignments
  --
  assignment_id
  conversation_id
  agent_user_id
  active_conversation_id
  assigned_at
  released_at
  is_active
}

class "ConversationMessage" as ConversationMessage <<entity>> {
  {static} table = conversation_messages
  --
  message_id
  conversation_id
  sender_id
  related_reservation_id
  related_order_id
  processing_status
  created_at
}

class "ConversationFile" as ConversationFile <<entity>> {
  {static} table = conversation_files
  --
  file_id
  message_id
  created_at
  file_url
  mime_type
}

class "ConversationEvent" as ConversationEvent <<entity>> {
  {static} table = conversation_events
  --
  event_id
  conversation_id
  event_by_user_id
  created_at
  event_type
  event_data
}

class "ConversationAnalysis" as ConversationAnalysis <<entity>> {
  {static} table = conversation_analyses
  --
  analysis_id
  conversation_id
  created_at
  analyzer_name
  is_spam
  quality_score
  extracted_info
}

class "MessageEntity" as MessageEntity <<pivot>> {
  {static} table = message_entities
  --
  message_entity_id
  message_id
  extra_json
  created_at
  entity_type
  entity_text
  entity_normalized
}

class "NotificationOutbox" as NotificationOutbox <<outbox>> {
  {static} table = notification_outbox
  --
  outbox_id
  recipient_user_id
  related_reservation_id
  idempotency_key
  processing_token
  status
  payload_json
}

class "NotificationDeliveryAttempt" as NotificationDeliveryAttempt <<outbox>> {
  {static} table = notification_delivery_attempts
  --
  attempt_id
  outbox_id
  status
  provider_status
  error_code
  provider_message_id
  request_payload_json
}

class "StaffConversationInboxService" as StaffConversationInboxService <<control>> {
  orchestrates flow
}

class "StaffConversationWorkflowService" as StaffConversationWorkflowService <<control>> {
  orchestrates flow
}

class "StaffConversationOutboundReplySupportService" as StaffConversationOutboundReplySupportService <<control>> {
  orchestrates flow
}

class "NotificationOutboxService" as NotificationOutboxService <<control>> {
  orchestrates flow
}

class "NotificationChannelManager" as NotificationChannelManager <<control>> {
  orchestrates flow
}

User "1" --> "0..*" Reservation : reservations\nFK: user_id
User "1" --> "0..*" Conversation : conversations\nFK: user_id
WaitingList "0..*" --> "1" User : user\nFK: user_id
Conversation "0..*" --> "1" Reservation : linkedReservation\nFK: linked_reservation_id
Conversation "0..*" --> "1" WaitingList : linkedWaitingList\nFK: linked_waiting_list_id
Conversation "1" --> "0..*" AgentAssignment : assignments\nFK: conversation_id
Conversation "1" --> "0..*" ConversationMessage : messages\nFK: conversation_id
Conversation "1" --> "0..*" ConversationEvent : events\nFK: conversation_id
Conversation "1" --> "0..*" ConversationAnalysis : analyses\nFK: conversation_id
AgentAssignment "0..*" --> "1" User : agent\nFK: agent_user_id
ConversationMessage "0..*" --> "1" User : senderUser\nFK: sender_id
ConversationMessage "0..*" --> "1" Reservation : relatedReservation\nFK: related_reservation_id
ConversationMessage "1" --> "0..*" ConversationFile : files\nFK: message_id
ConversationMessage "1" --> "0..*" MessageEntity : entities\nFK: message_id
ConversationEvent "0..*" --> "1" User : byUser\nFK: event_by_user_id
NotificationOutbox "0..*" --> "1" Reservation : reservation\nFK: related_reservation_id
NotificationOutbox "0..*" --> "1" User : recipientUser\nFK: recipient_user_id
NotificationOutbox "1" --> "0..*" NotificationDeliveryAttempt : attempts\nFK: outbox_id
StaffConversationInboxService ..> User : uses
StaffConversationWorkflowService ..> User : uses
StaffConversationOutboundReplySupportService ..> User : uses
NotificationOutboxService ..> User : uses
NotificationChannelManager ..> User : uses
@enduml

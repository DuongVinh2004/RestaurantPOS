@startuml
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment left
skinparam usecase {
  BackgroundColor white
  BorderColor #374151
  ArrowColor #4B5563
  FontColor black
}
skinparam actor {
  BorderColor #374151
  FontColor black
}

title UC-12 - Tạo order và cập nhật món
actor "Nhân viên" as A1
rectangle "RestaurantPOS Backend" as SYS {
  usecase "UC-12\nTạo order và cập nhật món" as MAIN
  usecase "Tạo active order" as S01
  usecase "Thêm món vào order" as S02
  usecase "Cập nhật / đóng order" as S03
  usecase "Tạo bill snapshot" as S04
  usecase "Xem settlement preview" as S05
  usecase "Kiểm tra menu item + trạng thái order" as S06
}
S01 ..> MAIN : <<extend>>
S02 ..> MAIN : <<extend>>
S03 ..> MAIN : <<extend>>
S04 ..> MAIN : <<extend>>
S05 ..> MAIN : <<extend>>
MAIN ..> S06 : <<include>>
A1 --> MAIN
@enduml

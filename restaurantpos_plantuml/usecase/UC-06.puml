@startuml
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment left
skinparam usecase {
  BackgroundColor white
  BorderColor #374151
  ArrowColor #4B5563
  FontColor black
}
skinparam actor {
  BorderColor #374151
  FontColor black
}

title UC-06 - Khách tự quản lý reservation
actor "Khách hàng" as A1
rectangle "RestaurantPOS Backend" as SYS {
  usecase "UC-06\nKhách tự quản lý reservation" as MAIN
  usecase "Xem danh sách reservation của mình" as S01
  usecase "Xem chi tiết reservation" as S02
  usecase "Hủy reservation" as S03
  usecase "Đổi lịch reservation" as S04
  usecase "Kiểm tra owner scope" as S05
  usecase "Áp cutoff / status guard" as S06
}
MAIN ..> S01 : <<include>>
MAIN ..> S02 : <<include>>
S03 ..> MAIN : <<extend>>
S04 ..> MAIN : <<extend>>
MAIN ..> S05 : <<include>>
MAIN ..> S06 : <<include>>
A1 --> MAIN
@enduml

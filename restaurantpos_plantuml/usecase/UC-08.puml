@startuml
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment left
skinparam usecase {
  BackgroundColor white
  BorderColor #374151
  ArrowColor #4B5563
  FontColor black
}
skinparam actor {
  BorderColor #374151
  FontColor black
}

title UC-08 - Quản lý phiên thanh toán deposit / bill
actor "Khách hàng" as Customer
actor "Payment Provider / Webhook" as Provider
rectangle "RestaurantPOS Backend" as SYS {
  usecase "UC-08\nQuản lý phiên thanh toán deposit / bill" as MAIN
  usecase "Mở deposit payment session" as S01
  usecase "Mở bill payment session" as S02
  usecase "Xem trạng thái payment session" as S03
  usecase "Refresh payment session" as S04
  usecase "Confirm payment session và áp settlement" as S05
  usecase "Nhận payment provider webhook" as S06
}
S01 ..> MAIN : <<extend>>
S02 ..> MAIN : <<extend>>
MAIN ..> S03 : <<include>>
S04 ..> MAIN : <<extend>>
S05 ..> MAIN : <<extend>>
S06 ..> MAIN : <<extend>>
Customer --> MAIN
Provider --> S06

@enduml

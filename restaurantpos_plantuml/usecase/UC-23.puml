@startuml
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment left
skinparam usecase {
  BackgroundColor white
  BorderColor #374151
  ArrowColor #4B5563
  FontColor black
}
skinparam actor {
  BorderColor #374151
  FontColor black
}

title UC-23 - Mở / xem / đóng cashier shift
actor "Thu ngân / Nhân viên" as Cashier
rectangle "RestaurantPOS Backend" as SYS {
  usecase "UC-23\nMở / xem / đóng cashier shift" as MAIN
  usecase "Mở shift với opening float và terminal" as S01
  usecase "Xem shift hiện tại và lịch sử shift" as S02
  usecase "Xem chi tiết shift và snapshot thanh toán" as S03
  usecase "Đóng shift và chốt chênh lệch tiền mặt" as S04
}
S01 ..> MAIN : <<extend>>
MAIN ..> S02 : <<include>>
S03 ..> MAIN : <<extend>>
S04 ..> MAIN : <<extend>>
Cashier --> MAIN

@enduml

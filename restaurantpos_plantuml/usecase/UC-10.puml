@startuml
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment left
skinparam usecase {
  BackgroundColor white
  BorderColor #374151
  ArrowColor #4B5563
  FontColor black
}
skinparam actor {
  BorderColor #374151
  FontColor black
}

title UC-10 - Check-in reservation hoặc mở service session walk-in
actor "Nhân viên" as A1
rectangle "RestaurantPOS Backend" as SYS {
  usecase "UC-10\nCheck-in reservation hoặc mở service session walk-in" as MAIN
  usecase "Check-in reservation" as S01
  usecase "Mở walk-in service session" as S02
  usecase "Xem table board / service context" as S03
  usecase "Kiểm tra branch scope + trạng thái bàn" as S04
}
S01 ..> MAIN : <<extend>>
S02 ..> MAIN : <<extend>>
MAIN ..> S03 : <<include>>
MAIN ..> S04 : <<include>>
A1 --> MAIN
@enduml

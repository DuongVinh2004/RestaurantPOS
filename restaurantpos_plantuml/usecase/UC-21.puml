@startuml
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment left
skinparam usecase {
  BackgroundColor white
  BorderColor #374151
  ArrowColor #4B5563
  FontColor black
}
skinparam actor {
  BorderColor #374151
  FontColor black
}

title UC-21 - Theo dõi audit, báo cáo và đối soát
actor "Nhân viên / Quản trị viên" as A1
rectangle "RestaurantPOS Backend" as SYS {
  usecase "UC-21\nTheo dõi audit, báo cáo và đối soát" as MAIN
  usecase "Xem audit trail" as S01
  usecase "Xem reporting snapshot" as S02
  usecase "Xem doanh thu / settlement / invoice context" as S03
  usecase "Xem realtime changes / board read-model" as S04
  usecase "Lọc theo actor / subject / reservation / date range" as S05
}
S01 ..> MAIN : <<extend>>
S02 ..> MAIN : <<extend>>
S03 ..> MAIN : <<extend>>
S04 ..> MAIN : <<extend>>
MAIN ..> S05 : <<include>>
A1 --> MAIN
@enduml

@startuml
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment left
skinparam usecase {
  BackgroundColor white
  BorderColor #374151
  ArrowColor #4B5563
  FontColor black
}
skinparam actor {
  BorderColor #374151
  FontColor black
}

title UC-16 - Áp dụng voucher / loyalty / benefits
actor "Khách hàng / Nhân viên" as A1
rectangle "RestaurantPOS Backend" as SYS {
  usecase "UC-16\nÁp dụng voucher / loyalty / benefits" as MAIN
  usecase "Xem benefits preview" as S01
  usecase "Áp voucher" as S02
  usecase "Gỡ / release voucher" as S03
  usecase "Redeem loyalty" as S04
  usecase "Release loyalty" as S05
  usecase "Kiểm tra payment / reservation state" as S06
}
MAIN ..> S01 : <<include>>
S02 ..> MAIN : <<extend>>
S03 ..> MAIN : <<extend>>
S04 ..> MAIN : <<extend>>
S05 ..> MAIN : <<extend>>
MAIN ..> S06 : <<include>>
A1 --> MAIN
@enduml

@startuml
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment left
skinparam usecase {
  BackgroundColor white
  BorderColor #374151
  ArrowColor #4B5563
  FontColor black
}
skinparam actor {
  BorderColor #374151
  FontColor black
}

title UC-15 - Refund hoặc refund kèm hủy reservation
actor "Nhân viên / Thu ngân" as CashierStaff
rectangle "RestaurantPOS Backend" as SYS {
  usecase "UC-15\nRefund hoặc refund kèm hủy reservation" as MAIN
  usecase "Xem refund preview" as S01
  usecase "Refund payment" as S02
  usecase "Refund và hủy reservation" as S03
  usecase "Kiểm tra refund lineage và giới hạn hoàn tiền" as S04
}
MAIN ..> S01 : <<include>>
S02 ..> MAIN : <<extend>>
S03 ..> MAIN : <<extend>>
MAIN ..> S04 : <<include>>
CashierStaff --> MAIN

@enduml

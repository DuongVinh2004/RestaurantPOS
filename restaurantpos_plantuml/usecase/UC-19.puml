@startuml
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment left
skinparam usecase {
  BackgroundColor white
  BorderColor #374151
  ArrowColor #4B5563
  FontColor black
}
skinparam actor {
  BorderColor #374151
  FontColor black
}

title UC-19 - Xử lý conversation inbox nội bộ
actor "Nhân viên" as A1
rectangle "RestaurantPOS Backend" as SYS {
  usecase "UC-19\nXử lý conversation inbox nội bộ" as MAIN
  usecase "Xem inbox / thread" as S01
  usecase "Assign / take over conversation" as S02
  usecase "Đổi workflow state" as S03
  usecase "Link / unlink reservation / waiting-list" as S04
  usecase "Thêm internal note" as S05
  usecase "Gửi outbound reply" as S06
}
MAIN ..> S01 : <<include>>
S02 ..> MAIN : <<extend>>
S03 ..> MAIN : <<extend>>
S04 ..> MAIN : <<extend>>
S05 ..> MAIN : <<extend>>
S06 ..> MAIN : <<extend>>
A1 --> MAIN
@enduml

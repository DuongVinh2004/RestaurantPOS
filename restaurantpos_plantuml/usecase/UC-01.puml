@startuml
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment left
skinparam usecase {
  BackgroundColor white
  BorderColor #374151
  ArrowColor #4B5563
  FontColor black
}
skinparam actor {
  BorderColor #374151
  FontColor black
}

title UC-01 - Đăng nhập khách hàng
actor "Khách hàng" as Customer
rectangle "RestaurantPOS Backend" as SYS {
  usecase "UC-01\nĐăng nhập khách hàng" as MAIN
  usecase "Xác thực credential customer" as S01
  usecase "Tạo customer access session" as S02
  usecase "Lấy hồ sơ phiên hiện tại" as S03
  usecase "Refresh customer session" as S04
  usecase "Logout customer session" as S05
}
MAIN ..> S01 : <<include>>
MAIN ..> S02 : <<include>>
S03 ..> MAIN : <<extend>>
S04 ..> MAIN : <<extend>>
S05 ..> MAIN : <<extend>>
Customer --> MAIN

@enduml

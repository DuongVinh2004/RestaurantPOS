@startuml
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment left
skinparam usecase {
  BackgroundColor white
  BorderColor #374151
  ArrowColor #4B5563
  FontColor black
}
skinparam actor {
  BorderColor #374151
  FontColor black
}

title UC-20 - Xử lý privacy request và export dữ liệu
actor "Khách hàng" as A1
actor "Quản trị viên" as A2
rectangle "RestaurantPOS Backend" as SYS {
  usecase "UC-20\nXử lý privacy request và export dữ liệu" as MAIN
  usecase "Khách export dữ liệu của mình" as S01
  usecase "Khách tạo privacy request" as S02
  usecase "Admin xem danh sách request" as S03
  usecase "Admin review dry-run" as S04
  usecase "Admin approve commit" as S05
  usecase "Chặn commit khi còn blocker runtime" as S06
}
S01 ..> MAIN : <<extend>>
S02 ..> MAIN : <<extend>>
S03 ..> MAIN : <<extend>>
S04 ..> MAIN : <<extend>>
S05 ..> MAIN : <<extend>>
MAIN ..> S06 : <<include>>
A1 --> MAIN
A2 --> MAIN
A2 --> S03
A2 --> S04
A2 --> S05
@enduml

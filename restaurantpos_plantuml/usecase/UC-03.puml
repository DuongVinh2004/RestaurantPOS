@startuml
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment left
skinparam usecase {
  BackgroundColor white
  BorderColor #374151
  ArrowColor #4B5563
  FontColor black
}
skinparam actor {
  BorderColor #374151
  FontColor black
}

title UC-03 - Tra cứu bàn trống
actor "Khách hàng / Nhân viên" as A1
rectangle "RestaurantPOS Backend" as SYS {
  usecase "UC-03\nTra cứu bàn trống" as MAIN
  usecase "Xác định branch + timezone" as S01
  usecase "Resolve business hours / closure windows" as S02
  usecase "Kiểm tra booking policy" as S03
  usecase "Tính candidate tables theo sức chứa" as S04
  usecase "Trả gợi ý khi không còn bàn phù hợp" as S05
}
MAIN ..> S01 : <<include>>
MAIN ..> S02 : <<include>>
MAIN ..> S03 : <<include>>
MAIN ..> S04 : <<include>>
S05 ..> MAIN : <<extend>>
A1 --> MAIN
@enduml

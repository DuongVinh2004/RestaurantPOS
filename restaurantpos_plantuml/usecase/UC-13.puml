@startuml
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment left
skinparam usecase {
  BackgroundColor white
  BorderColor #374151
  ArrowColor #4B5563
  FontColor black
}
skinparam actor {
  BorderColor #374151
  FontColor black
}

title UC-13 - Dispatch bếp và cập nhật vòng đời món
actor "Nhân viên" as A1
actor "Nhân viên bếp" as A2
rectangle "RestaurantPOS Backend" as SYS {
  usecase "UC-13\nDispatch bếp và cập nhật vòng đời món" as MAIN
  usecase "Dispatch order sang kitchen" as S01
  usecase "Fire ticket" as S02
  usecase "Bump ticket" as S03
  usecase "Recall ticket" as S04
  usecase "Xem stream thay đổi bếp" as S05
  usecase "Kiểm tra station / route / ticket state" as S06
}
S01 ..> MAIN : <<extend>>
S02 ..> MAIN : <<extend>>
S03 ..> MAIN : <<extend>>
S04 ..> MAIN : <<extend>>
MAIN ..> S05 : <<include>>
MAIN ..> S06 : <<include>>
A1 --> MAIN
A2 --> MAIN
A2 --> S02
A2 --> S03
A2 --> S04
@enduml

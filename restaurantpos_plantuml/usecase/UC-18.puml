@startuml
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment left
skinparam usecase {
  BackgroundColor white
  BorderColor #374151
  ArrowColor #4B5563
  FontColor black
}
skinparam actor {
  BorderColor #374151
  FontColor black
}

title UC-18 - Quản lý tồn kho, mua hàng và cấu hình bếp
actor "Quản trị viên" as Admin
rectangle "RestaurantPOS Backend" as SYS {
  usecase "UC-18\nQuản lý tồn kho, mua hàng và cấu hình bếp" as MAIN
  usecase "Quản lý ingredient và supplier" as S01
  usecase "Quản lý purchase order" as S02
  usecase "Ghi nhận receipt và stock movement" as S03
  usecase "Cấu hình kitchen station và category route" as S04
}
S01 ..> MAIN : <<extend>>
S02 ..> MAIN : <<extend>>
S03 ..> MAIN : <<extend>>
S04 ..> MAIN : <<extend>>
Admin --> MAIN

@enduml

@startuml
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment left
skinparam usecase {
  BackgroundColor white
  BorderColor #374151
  ArrowColor #4B5563
  FontColor black
}
skinparam actor {
  BorderColor #374151
  FontColor black
}

title UC-11 - Gán bàn / đổi bàn / giải phóng bàn
actor "Nhân viên" as A1
rectangle "RestaurantPOS Backend" as SYS {
  usecase "UC-11\nGán bàn / đổi bàn / giải phóng bàn" as MAIN
  usecase "Assign suggested / best-fit table" as S01
  usecase "Move table" as S02
  usecase "Release table" as S03
  usecase "Kiểm tra row version + board state" as S04
}
S01 ..> MAIN : <<extend>>
S02 ..> MAIN : <<extend>>
S03 ..> MAIN : <<extend>>
MAIN ..> S04 : <<include>>
A1 --> MAIN
@enduml

@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam ArrowFontSize 9
skinparam nodesep 110
skinparam ranksep 130

top to bottom direction
hide circle
title ERD-00 - Tổng quan backbone nghiệp vụ
caption ERD chỉ mục cấp cao để nhìn nhanh trục dữ liệu chính của RestaurantPOS trước khi tách theo domain\nchi tiết.
skinparam linetype ortho
skinparam entity {
  BackgroundColor white
  BorderColor #374151
}

entity "users" as users {
  * user_id
    role_id
    current_tier_id
    privacy_anonymized_at
    full_name
}

entity "branches" as branches {
  * branch_id
    branch_code
    currency
}

entity "restaurant_tables" as restaurant_tables {
  * table_id
    branch_id
    template_id
    status
    table_code
}

entity "table_holds" as table_holds {
  * hold_id
    session_id
    hold_status
    user_id
    branch_id
    confirmed_reservation_id
}

entity "reservations" as reservations {
  * reservation_id
    status
    deposit_status
    deposit_paid_amount
}

entity "waiting_list" as waiting_list {
  * waiting_id
    user_id
    branch_id
    notified_by
    updated_by
    status
    customer_response_status
}

entity "reservation_orders" as reservation_orders {
  * order_id
    reservation_id
    created_by
    updated_by
    status
}

entity "payments" as payments {
  * payment_id
    reservation_id
    branch_id
    refund_of_payment_id
    created_by
    updated_by
    status
}

entity "conversations" as conversations {
  * conversation_id
    branch_id
    user_id
    linked_reservation_id
    linked_waiting_list_id
    status
}

entity "reservation_tables" as reservation_tables {
  * reservation_table_id
    reservation_id
    table_id
}

entity "table_hold_details" as table_hold_details {
  * hold_detail_id
    hold_id
    table_id
}

reservations ||--o{ reservation_tables : reservation_id
restaurant_tables ||--o{ reservation_tables : table_id
branches ||--o{ table_holds : branch_id
reservations |o--o{ table_holds : confirmed_reservation_id
users |o--o{ table_holds : user_id
branches ||--o{ conversations : branch_id
reservations |o--o{ conversations : linked_reservation_id
waiting_list |o--o{ conversations : linked_waiting_list_id
users |o--o{ conversations : user_id
users |o--o{ reservation_orders : created_by
reservations ||--o{ reservation_orders : reservation_id
users |o--o{ reservation_orders : updated_by
table_holds ||--o{ table_hold_details : hold_id
restaurant_tables ||--o{ table_hold_details : table_id
branches ||--o{ waiting_list : branch_id
users |o--o{ waiting_list : notified_by
users |o--o{ waiting_list : updated_by
users |o--o{ waiting_list : user_id
branches ||--o{ restaurant_tables : branch_id
branches ||--o{ payments : branch_id
users |o--o{ payments : created_by
payments |o--o{ payments : refund_of_payment_id
reservations ||--o{ payments : reservation_id
users |o--o{ payments : updated_by

branches -[hidden]right- users
users -[hidden]right- reservations

restaurant_tables -[hidden]right- table_holds
table_holds -[hidden]right- waiting_list
waiting_list -[hidden]right- reservation_orders
reservation_orders -[hidden]right- payments
payments -[hidden]right- conversations

reservation_tables -[hidden]right- table_hold_details

branches -[hidden]down- restaurant_tables
users -[hidden]down- waiting_list
reservations -[hidden]down- payments
restaurant_tables -[hidden]down- reservation_tables
table_holds -[hidden]down- table_hold_details
@enduml






@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam activity {
  BackgroundColor white
  BorderColor #374151
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #4B5563
}
title AD-14 - Staff notify / seat / advance waiting list
start
partition "Nhân viên" {
  :Chọn thao tác notify, seat, advance hoặc cancel entry;
}
partition "StaffWaitingListController" {
  :Nhận staff waiting-list mutation;
  :Áp capability waiting_list.manage và idempotency key tương ứng;
}
if (Notify entry?) then (yes)
  partition "StaffWaitingListService" {
    :Load waiting entry và row_version hiện tại;
    :Kiểm tra notify window, branch scope và trạng thái Waiting/Notified;
  }
  if (Notify hợp lệ?) then (yes)
    partition "StaffWaitingListService" {
      :Cập nhật notified_at, notify_expires_at và trạng thái Notified;
    }
    stop
  else (no)
    partition "StaffWaitingListController" {
      :Trả notify denied;
    }
    stop
  endif
else (no)
  if (Seat entry?) then (yes)
    partition "StaffWaitingListService" {
      :Load entry, branch/table context và row_version;
      :Kiểm tra entry còn seatable;
    }
    if (Seat hợp lệ?) then (yes)
      partition "StaffWaitingListService" {
        :Tạo reservation phục vụ seating;
        :Cập nhật waiting_list = Seated;
      }
      stop
    else (no)
      partition "StaffWaitingListController" {
        :Trả seat denied;
      }
      stop
    endif
  else (advance/cancel)
    partition "WaitingListOperationalOrchestrationService" {
      :Advance queue sau phản hồi khách hoặc hủy entry;
      :Giữ automation meta cho next eligible entry nếu có;
    }
    if (Command hợp lệ?) then (yes)
      stop
    else (no)
      partition "StaffWaitingListController" {
        :Trả advance/cancel denied;
      }
      stop
    endif
  endif
endif
@enduml

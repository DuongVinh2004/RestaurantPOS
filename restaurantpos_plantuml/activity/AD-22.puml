@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam activity {
  BackgroundColor white
  BorderColor #374151
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #4B5563
}
title AD-22 - Refund
start
partition "Nhân viên / Thu ngân" {
  :Xem refund preview và thực hiện refund;
}
partition "StaffCheckoutController" {
  :Nhận refund-preview / refund;
  :Áp capability payment.refund + idempotency;
}
partition "CheckoutPayments" {
  :Load payment lineage + reservation state;
  :Kiểm tra giới hạn refund;
  :Persist payment refund record;
}
if (Refund hợp lệ?) then (yes)
partition "CheckoutPayments" {
  :Trả refund applied;
}
  stop
else (no)
partition "StaffCheckoutController" {
  :Trả refund denied;
}
  stop
endif
@enduml

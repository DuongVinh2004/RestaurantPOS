@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam activity {
  BackgroundColor white
  BorderColor #374151
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #4B5563
}
title AD-04 - Tạo table hold
start
partition "Khách hàng / Nhân viên" {
  :Chọn một hoặc nhiều bàn để giữ;
}
partition "TableHoldController" {
  :Nhận create hold;
  :Áp redis throttle / hold rate limit / idempotency;
}
partition "TableHoldService" {
  :Kiểm tra branch consistency + time window;
  :Kiểm tra conflict với reservation / hold hiện có;
  :Tạo hold và expiry time;
}
if (Có thể tạo hold?) then (yes)
partition "TableHoldService" {
  :Persist hold + table_hold_details;
}
  stop
else (no)
partition "TableHoldController" {
  :Trả hold create denied;
}
  stop
endif
@enduml

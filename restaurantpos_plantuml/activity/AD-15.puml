@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam activity {
  BackgroundColor white
  BorderColor #374151
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #4B5563
}
title AD-15 - Check-in reservation
start
partition "Nhân viên" {
  :Chọn reservation đến nơi để check-in;
}
partition "StaffReservationCheckInController" {
  :Nhận check-in;
  :Áp capability reservation.manage + idempotency;
}
partition "FloorOps + Reservations" {
  :Load reservation + board context;
  :Kiểm tra branch scope / table conflict / status;
  :Cập nhật reservation sang checked-in / in-service;
}
if (Reservation cho phép check-in?) then (yes)
partition "FloorOps + Reservations" {
  :Persist check-in state;
}
  stop
else (no)
partition "StaffReservationCheckInController" {
  :Trả check-in denied;
}
  stop
endif
@enduml

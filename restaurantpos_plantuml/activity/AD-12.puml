@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam activity {
  BackgroundColor white
  BorderColor #374151
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #4B5563
}
title AD-12 - Tạo và xác nhận payment session
start
partition "Khách hàng" {
  :Tạo deposit/bill payment session;
  :Có thể refresh hoặc confirm sau khi tương tác provider;
}
partition "Payment session controllers" {
  :Nhận store / show / refresh / confirm;
  :Áp owner scope + idempotency cho create/refresh/confirm;
}
partition "Payment Provider" {
  :Mở payment session;
  :Trả kết quả payment;
  :Gọi webhook callback;
}
partition "CheckoutPayments module" {
  :Kiểm tra outstanding;
  :Persist payment session;
  :Verify chữ ký webhook;
  :Chống replay;
  :Apply payment vào session / reservation / bill;
}
if (Provider và outstanding hợp lệ?) then (yes)
partition "CheckoutPayments module" {
  :Trả session created / pending / succeeded;
}
  stop
else (no)
partition "Payment session controllers" {
  :Trả create/confirm denied;
}
  stop
endif
@enduml

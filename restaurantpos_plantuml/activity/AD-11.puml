@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam activity {
  BackgroundColor white
  BorderColor #374151
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #4B5563
}
title AD-11 - Quản lý deposit intent
start
partition "Khách hàng" {
  :Xem deposit preview / acknowledge / submit intent / revoke intent;
}
partition "CustomerReservationDepositController" {
  :Nhận deposit actions;
  :Áp idempotency cho acknowledge / intent / revoke;
}
partition "Deposit policy + Reservations" {
  :Kiểm tra owner scope + reservation state;
  :Tính outstanding deposit;
  :Ghi acknowledge hoặc intent state;
}
if (Reservation còn cho phép deposit?) then (yes)
partition "Deposit policy + Reservations" {
  :Persist deposit intent state;
}
  stop
else (no)
partition "CustomerReservationDepositController" {
  :Trả deposit action denied;
}
  stop
endif
@enduml

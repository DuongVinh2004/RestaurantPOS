@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam activity {
  BackgroundColor white
  BorderColor #374151
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #4B5563
}
title AD-21 - Bill snapshot / settlement preview / pay / finalize
start
partition "Nhân viên / Thu ngân" {
  :Chọn bill snapshot, settlement preview, pay, checkout hoặc finalize;
}
partition "StaffCheckoutController" {
  :Nhận checkout command tương ứng;
  :Áp capability settlement.manage hoặc order.manage;
  :Áp idempotency key cho close/pay/checkout/finalize;
}
if (Snapshot hoặc preview?) then (yes)
  partition "CheckoutPayments services" {
    :Load order, locked payment lineage và bill context;
    :Tạo bill snapshot hoặc settlement preview;
  }
  if (Order còn mutable hoặc dữ liệu stale?) then (yes)
    partition "StaffCheckoutController" {
      :Trả preview denied;
    }
    stop
  else (no)
    partition "CheckoutPayments services" {
      :Trả snapshot / preview đã chuẩn hóa;
    }
    stop
  endif
else (no)
  if (Pay order?) then (yes)
    partition "CheckoutPayments services" {
      :Kiểm tra outstanding, payment method và cashier shift context nếu cần;
      :Persist payments, linked invoice/shift state;
    }
    if (Payment hợp lệ?) then (yes)
      partition "CheckoutPayments services" {
        :Đồng bộ reservation/order financial state;
      }
      stop
    else (no)
      partition "StaffCheckoutController" {
        :Trả pay denied;
      }
      stop
    endif
  else (checkout/finalize)
    partition "CheckoutPayments services" {
      :Kiểm tra outstanding đã được settle và bill lock còn hợp lệ;
      :Hoàn tất checkout hoặc finalize settlement;
      :Đồng bộ completed state cho reservation/order;
    }
    if (Finalize hợp lệ?) then (yes)
      stop
    else (no)
      partition "StaffCheckoutController" {
        :Trả checkout/finalize denied;
      }
      stop
    endif
  endif
endif
@enduml

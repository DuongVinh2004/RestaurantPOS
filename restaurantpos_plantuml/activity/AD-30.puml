@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam activity {
  BackgroundColor white
  BorderColor #374151
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #4B5563
}
title AD-30 - Privacy / reporting / ops readiness
start
partition "Khách hàng / Nhân viên / Quản trị viên / Operator" {
  :Chọn privacy request, reporting read, audit/reconciliation read,\nhoặc health/metrics/release readiness check;
}
partition "Customer + Staff + Ops controllers / CLI" {
  :Route tới privacy, reporting, audit hoặc ops boundary tương ứng;
  :Áp owner scope, staff capability hoặc signed/CLI contract phù hợp;
}
if (Privacy request / export?) then (yes)
  partition "PrivacyAudit services" {
    :Export customer data hoặc tạo privacy request;
    :Tôn trọng retention và finance/audit keep rules;
  }
  stop
else (no)
  if (Reporting / audit / reconciliation?) then (yes)
    partition "Reporting + Audit services" {
      :Đọc audit trail, reporting snapshot hoặc reconciliation payload;
      :Không mutate transaction source tables;
    }
    stop
  else (ops readiness)
    partition "Health / Metrics / Release checks" {
      :Probe DB, Redis, scheduler heartbeat và operational insights;
      :Dump metrics hoặc chạy release-manifest / deploy-check / outbox-health;
    }
    if (Runtime contract pass?) then (yes)
      stop
    else (no)
      partition "Customer + Staff + Ops controllers / CLI" {
        :Trả degraded / fail result kèm evidence;
      }
      stop
    endif
  endif
endif
@enduml

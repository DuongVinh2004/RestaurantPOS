@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam activity {
  BackgroundColor white
  BorderColor #374151
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #4B5563
}
title AD-17 - Gán bàn / đổi bàn / giải phóng bàn
start
partition "Nhân viên" {
  :Chọn assign, move hoặc release table;
}
partition "FloorOps controllers" {
  :Nhận board mutation tương ứng;
  :Áp capability reservation.manage hoặc table.release;
  :Áp idempotency key cho assign / move / release;
}
if (Assign reservation?) then (yes)
  partition "StaffReservationBoardAssignmentService" {
    :Tải reservation, candidate table và row_version;
    :Kiểm tra reservation Confirmed, chưa check-in và không conflict;
  }
  if (Assign hợp lệ?) then (yes)
    partition "StaffReservationBoardAssignmentService" {
      :Commit reservation_tables và đồng bộ board state;
    }
    stop
  else (no)
    partition "FloorOps controllers" {
      :Trả assign denied;
    }
    stop
  endif
else (no)
  if (Move table?) then (yes)
    partition "StaffMoveTableService" {
      :Khóa reservation + source/target tables;
      :Kiểm tra checked-in state, row_version, capacity và conflict;
    }
    if (Move hợp lệ?) then (yes)
      partition "StaffMoveTableService" {
        :Chuyển assignment sang target table;
        :Giải phóng source table nếu không còn context;
      }
      stop
    else (no)
      partition "FloorOps controllers" {
        :Trả move denied;
      }
      stop
    endif
  else (release table)
    partition "StaffTableReleaseService" {
      :Khóa table và active reservation/order liên quan;
      :Kiểm tra release guard, row_version và force flag;
    }
    if (Release hợp lệ?) then (yes)
      partition "StaffTableReleaseService" {
        :Release table state an toàn;
        :Publish realtime board event;
      }
      stop
    else (no)
      partition "FloorOps controllers" {
        :Trả release denied;
      }
      stop
    endif
  endif
endif
@enduml

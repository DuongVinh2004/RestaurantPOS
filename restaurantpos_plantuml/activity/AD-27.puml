@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam activity {
  BackgroundColor white
  BorderColor #374151
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #4B5563
}
title AD-27 - Admin import / export dữ liệu nền
start
partition "Quản trị viên" {
  :Yêu cầu export hoặc import master data;
}
partition "Admin import/export controllers" {
  :Nhận export / import route;
  :Áp capability + idempotency khi commit;
}
partition "AdminMasterDataBulk" {
  :Assemble export artifact;
  :Analyze import file dry-run;
  :Commit transactional batch khi được phép;
}
if (Import mode = dry-run?) then (yes)
partition "AdminMasterDataBulk" {
  :Trả can_commit / errors / changes;
}
  stop
else (no)
partition "AdminMasterDataBulk" {
  :Xuất dữ liệu hoặc commit batch;
}
  stop
endif
@enduml

@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam activity {
  BackgroundColor white
  BorderColor #374151
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #4B5563
}
title AD-29 - Conversation inbox nội bộ
start
partition "Nhân viên" {
  :Xem inbox, assign, take over, đổi workflow, link/unlink, internal note, outbound reply;
}
partition "StaffConversationInboxController" {
  :Nhận conversation routes;
  :Áp capability conversation.manage + idempotency;
}
partition "Conversations module" {
  :Load inbox/thread state;
  :Persist assignment / workflow / linkage / notes;
  :Queue outbound reply khi cần;
}
if (Conversation action hợp lệ?) then (yes)
partition "Conversations module" {
  :Trả updated conversation state;
}
  stop
else (no)
partition "StaffConversationInboxController" {
  :Trả conversation action denied;
}
  stop
endif
@enduml

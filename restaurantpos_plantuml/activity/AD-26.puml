@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam activity {
  BackgroundColor white
  BorderColor #374151
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #4B5563
}
title AD-26 - Admin CRUD dữ liệu nền
start
partition "Quản trị viên" {
  :Tạo / sửa / xóa branch, table, menu, voucher, loyalty, settings;
}
partition "Admin controllers" {
  :Nhận admin CRUD route;
  :Áp StaffApiKeyMiddleware + staff.capability phù hợp;
}
partition "AdminMasterDataBulk + domain modules" {
  :Validate payload / policy;
  :Persist target domain tables;
}
if (Payload / policy hợp lệ?) then (yes)
partition "AdminMasterDataBulk + domain modules" {
  :Trả CRUD success;
}
  stop
else (no)
partition "Admin controllers" {
  :Trả CRUD denied;
}
  stop
endif
@enduml

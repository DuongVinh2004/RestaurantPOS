@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam activity {
  BackgroundColor white
  BorderColor #374151
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #4B5563
}
title AD-24 - Áp dụng / gỡ voucher
start
partition "Khách hàng / Nhân viên" {
  :Áp voucher hoặc gỡ / release voucher trên reservation;
}
partition "Benefits controllers" {
  :Nhận benefits preview / voucher apply / remove / release;
  :Áp idempotency tương ứng;
}
partition "BenefitsLoyalty" {
  :Kiểm tra reservation state + payment lock;
  :Kiểm tra voucher availability;
  :Persist voucher lock/apply/remove/release;
}
if (Voucher hợp lệ?) then (yes)
partition "BenefitsLoyalty" {
  :Trả reservation benefits state mới;
}
  stop
else (no)
partition "Benefits controllers" {
  :Trả voucher action denied;
}
  stop
endif
@enduml

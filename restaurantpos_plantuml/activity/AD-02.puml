@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam activity {
  BackgroundColor white
  BorderColor #374151
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #4B5563
}
title AD-02 - Đăng nhập nhân viên / quản trị
start
partition "Nhân viên / Quản trị viên" {
  :Gửi credential hoặc staff API key;
}
partition "StaffAuthController" {
  :Nhận login staff;
  :Áp throttle login staff;
  :Gọi staff auth service;
}
partition "Staff auth + capability guard" {
  :Xác thực actor staff/admin hoặc staff key;
  :Tạo / chấp nhận session / key context;
  :Áp capability ở route nội bộ kế tiếp;
}
if (Credential / key hợp lệ?) then (yes)
partition "Staff auth + capability guard" {
  :Trả actor context hoặc cho phép vào route nội bộ;
}
  stop
else (no)
partition "StaffAuthController" {
  :Trả unauthorized / forbidden;
}
  stop
endif
@enduml

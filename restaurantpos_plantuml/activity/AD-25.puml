@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam activity {
  BackgroundColor white
  BorderColor #374151
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #4B5563
}
title AD-25 - Redeem / release loyalty
start
partition "Khách hàng / Nhân viên" {
  :Redeem loyalty hoặc release loyalty đã redeem;
}
partition "Benefits / Loyalty controllers" {
  :Nhận loyalty show / redeem / release;
  :Áp idempotency tương ứng;
}
partition "BenefitsLoyalty" {
  :Kiểm tra điểm hiện có + reservation state;
  :Persist loyalty point transaction / release;
}
if (Điểm và trạng thái hợp lệ?) then (yes)
partition "BenefitsLoyalty" {
  :Trả loyalty outcome;
}
  stop
else (no)
partition "Benefits / Loyalty controllers" {
  :Trả loyalty action denied;
}
  stop
endif
@enduml

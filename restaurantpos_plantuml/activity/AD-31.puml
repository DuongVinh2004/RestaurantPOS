@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563

title AD-31 - Xử lý notification outbox
caption Worker lease due messages, re-check preference và quiet hours, ghi attempt evidence, rồi cập nhật outbox state.
skinparam activity {
  BackgroundColor white
  BorderColor #374151
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #4B5563
}
start
partition "Operator / Scheduler" {
  :Kích hoạt notifications:process-outbox hoặc scheduler heartbeat;
}
partition "NotificationOutboxService" {
  :Lease due outbox rows bằng processing token + lock window;
}
if (Có row đến hạn?) then (yes)
  partition "NotificationPreferenceService" {
    :Đánh giá preference, default opt-in và quiet hours theo timezone;
  }
  if (Preference disabled?) then (yes)
    partition "NotificationOutboxService" {
      :Không enqueue/sending thêm;
      :Ghi suppressed evidence nếu cần cho health/audit;
    }
    stop
  else (no)
    if (Quiet hours đang active?) then (yes)
      partition "NotificationOutboxService" {
        :Delay next_retry_at tới quiet_until;
        :Giữ outbox chưa gửi;
      }
      stop
    else (no)
      partition "NotificationChannelManager" {
        :Resolve enabled driver và provider metadata cho channel;
      }
      if (Driver / channel khả dụng?) then (yes)
        partition "Provider Channel" {
          :Gửi notification;
        }
        if (Provider accepted?) then (yes)
          partition "NotificationOutboxService" {
            :Ghi delivery attempt = Succeeded;
            :Cập nhật outbox = Sent;
          }
          stop
        else (no)
          if (Retryable failure?) then (yes)
            partition "NotificationOutboxService" {
              :Ghi delivery attempt = Failed;
              :Tăng attempt_count, cập nhật last_attempted_at và next_retry_at;
            }
            stop
          else (terminal)
            partition "NotificationOutboxService" {
              :Ghi delivery attempt = Failed hoặc Suppressed;
              :Cập nhật outbox = Cancelled;
            }
            stop
          endif
        endif
      else (no)
        partition "NotificationOutboxService" {
          :Cancel ngay vì channel disabled hoặc driver unsupported;
          :Ghi error_code phục vụ outbox-health / dead-letter review;
        }
        stop
      endif
    endif
  endif
else (no)
  :Không có outbox row đến hạn;
  stop
endif
@enduml

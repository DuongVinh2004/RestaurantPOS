@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam SequenceMessageAlign center
skinparam maxMessageSize 140
autonumber

title SD-08 - Quản lý phiên thanh toán deposit hoặc bill

actor "Khách hàng" as Customer
boundary "Customer Client" as Client
boundary "CustomerReservationDepositPaymentController" as DepositApi
boundary "CustomerReservationBillPaymentController" as BillApi
boundary "PaymentProviderWebhookController@handle" as WebhookApi
control "CustomerReservationDepositPaymentService" as DepositSvc
control "CustomerReservationBillPaymentService" as BillSvc
control "CustomerDepositPaymentProviderRegistry" as DepositProviders
control "CustomerBillPaymentProviderRegistry" as BillProviders
control "PaymentWebhookIngestionService" as WebhookSvc
control "ReservationDepositPaymentSessionLifecycleService" as DepositLifecycle
control "ReservationBillPaymentSessionLifecycleService" as BillLifecycle
actor "Payment Provider" as Provider
database "reservations + payments + reservation_deposit_payment_sessions\n+ reservation_bill_payment_sessions + payment_provider_webhook_receipts" as PayStore

alt create deposit payment session
  Customer -> Client : tạo deposit session
  Client -> DepositApi : POST /api/v1/reservations/:reservation_id/deposit/payment-sessions
  DepositApi -> DepositSvc : createSession(reservation_id, payload, owner/session scope, idempotency_key)
  DepositSvc -> PayStore : lock reservation + validate row_version + outstanding deposit
  alt owner/session denied, stale row_version hoặc no outstanding
    PayStore --> DepositSvc : reject
    DepositSvc --> DepositApi : create denied
    DepositApi --> Client : business rule error
  else can create
    PayStore --> DepositSvc : reservation context
    DepositSvc -> DepositProviders : resolve provider + create session
    DepositProviders -> Provider : create checkout/payment session
    alt provider create failed
      Provider --> DepositProviders : create failed
      DepositProviders --> DepositSvc : provider error
      DepositSvc --> DepositApi : create failed
      DepositApi --> Client : session not created
    else provider session created
      Provider --> DepositProviders : provider session payload
      DepositProviders --> DepositSvc : provider session payload
      DepositSvc -> PayStore : persist reservation_deposit_payment_sessions row
      PayStore --> DepositSvc : stored session
      DepositSvc --> DepositApi : deposit payment session payload
      DepositApi --> Client : session created
    end
  end
else create bill payment session
  Customer -> Client : tạo bill session
  Client -> BillApi : POST /api/v1/reservations/:reservation_id/bill/payment-sessions
  BillApi -> BillSvc : createSession(reservation_id, payload, owner/session scope, idempotency_key)
  BillSvc -> PayStore : lock reservation + validate row_version + bill outstanding
  alt owner/session denied, stale row_version hoặc bill not self-pay ready
    PayStore --> BillSvc : reject
    BillSvc --> BillApi : create denied
    BillApi --> Client : business rule error
  else can create
    PayStore --> BillSvc : reservation + bill context
    BillSvc -> BillProviders : resolve provider + create session
    BillProviders -> Provider : create checkout/payment session
    alt provider create failed
      Provider --> BillProviders : create failed
      BillProviders --> BillSvc : provider error
      BillSvc --> BillApi : create failed
      BillApi --> Client : session not created
    else provider session created
      Provider --> BillProviders : provider session payload
      BillProviders --> BillSvc : provider session payload
      BillSvc -> PayStore : persist reservation_bill_payment_sessions row
      PayStore --> BillSvc : stored session
      BillSvc --> BillApi : bill payment session payload
      BillApi --> Client : session created
    end
  end
end

par customer refresh / confirm
  alt deposit refresh or confirm
    Customer -> Client : refresh hoặc confirm deposit session
    Client -> DepositApi : POST /api/v1/reservations/:reservation_id/deposit/payment-sessions/:session_id/refresh|confirm
    DepositApi -> DepositSvc : refreshSession / confirmSession(...)
    DepositSvc -> PayStore : lock reservation + session, validate owner/session scope + row_version
    alt session invalid / already terminal with no settlement change
      PayStore --> DepositSvc : current final state or reject
      DepositSvc --> DepositApi : current outcome / denied
      DepositApi --> Client : pending / succeeded / failed / error
    else refresh or confirm against provider
      PayStore --> DepositSvc : mutable session
      DepositSvc -> DepositProviders : refreshSession / confirmSession
      DepositProviders -> Provider : fetch or confirm provider state
      Provider --> DepositProviders : provider result
      DepositProviders --> DepositSvc : provider result
      DepositSvc -> DepositLifecycle : applyProviderResult + applySucceededSessionIfNeeded
      DepositLifecycle -> PayStore : update session + payment linkage when settled
      PayStore --> DepositLifecycle : updated state
      DepositLifecycle --> DepositSvc : final deposit outcome
      DepositSvc --> DepositApi : updated payload
      DepositApi --> Client : session state
    end
  else bill refresh or confirm
    Customer -> Client : refresh hoặc confirm bill session
    Client -> BillApi : POST /api/v1/reservations/:reservation_id/bill/payment-sessions/:session_id/refresh|confirm
    BillApi -> BillSvc : refreshSession / confirmSession(...)
    BillSvc -> PayStore : lock reservation + session, validate owner/session scope + row_version
    alt session invalid / already terminal with no settlement change
      PayStore --> BillSvc : current final state or reject
      BillSvc --> BillApi : current outcome / denied
      BillApi --> Client : pending / succeeded / failed / error
    else refresh or confirm against provider
      PayStore --> BillSvc : mutable session
      BillSvc -> BillProviders : refreshSession / confirmSession
      BillProviders -> Provider : fetch or confirm provider state
      Provider --> BillProviders : provider result
      BillProviders --> BillSvc : provider result
      BillSvc -> BillLifecycle : applyProviderResult + applySucceededSessionIfNeeded
      BillLifecycle -> PayStore : update session + payment linkage when settled
      PayStore --> BillLifecycle : updated state
      BillLifecycle --> BillSvc : final bill outcome
      BillSvc --> BillApi : updated payload
      BillApi --> Client : session state
    end
  end
else provider webhook
  Provider ->> WebhookApi : POST /api/v1/payments/providers/:provider_code/webhooks
  WebhookApi -> WebhookSvc : ingest(provider_code, raw_body, headers)
  WebhookSvc -> Provider : verify signature + parse webhook payload
  alt invalid signature
    Provider --> WebhookSvc : invalid
    WebhookSvc --> WebhookApi : 401 invalid_signature
  else valid webhook
    Provider --> WebhookSvc : parsed event
    WebhookSvc -> PayStore : create or resume payment_provider_webhook_receipt
    alt duplicate already applied
      PayStore --> WebhookSvc : existing receipt / duplicate
      WebhookSvc --> WebhookApi : 202 duplicate-safe response
    else first valid delivery
      PayStore --> WebhookSvc : receipt accepted
      alt deposit scope
        WebhookSvc -> DepositLifecycle : apply webhook event to deposit session
        DepositLifecycle -> PayStore : update deposit session + linked payment state
        PayStore --> DepositLifecycle : updated state
        DepositLifecycle --> WebhookSvc : applied / ignored result
      else bill scope
        WebhookSvc -> BillLifecycle : apply webhook event to bill session
        BillLifecycle -> PayStore : update bill session + linked payment state
        PayStore --> BillLifecycle : updated state
        BillLifecycle --> WebhookSvc : applied / ignored result
      end
      WebhookSvc --> WebhookApi : 202 accepted
    end
  end
end

@enduml

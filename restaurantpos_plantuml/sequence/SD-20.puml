@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam SequenceMessageAlign center
skinparam maxMessageSize 140
autonumber

title SD-20 - Privacy request / export

actor "Khách hàng" as Customer
actor "Quản trị viên" as Admin
boundary "CustomerDataLifecycleController\n+ admin privacy review route/controller" as Api
control "Privacy lifecycle service" as PrivacySvc
database "customer_privacy_requests + users\n+ related business/audit data" as PrivacyStore

alt customer data export
  Customer -> Api : GET /me/data-export
  Api -> PrivacySvc : assemble export in customer scope
  PrivacySvc -> PrivacyStore : read user-owned business data
  PrivacyStore --> PrivacySvc : export dataset
  PrivacySvc --> Api : export payload/artifact
  Api --> Customer : export response
else customer privacy request create/list
  Customer -> Api : GET / POST /me/privacy-requests
  Api -> PrivacySvc : list or create request
  PrivacySvc -> PrivacyStore : read/write customer_privacy_requests
  PrivacyStore --> PrivacySvc : request rows
  PrivacySvc --> Api : payload
  Api --> Customer : request status
else admin review / execute lifecycle
  Admin -> Api : review privacy request
  Api -> PrivacySvc : validate review action
  PrivacySvc -> PrivacyStore : read request + affected subjects
  alt dry-run review
    PrivacyStore --> PrivacySvc : impact preview
    PrivacySvc --> Api : review preview
    Api --> Admin : dry-run result
  else commit lifecycle action
    PrivacyStore --> PrivacySvc : request context
    PrivacySvc -> PrivacyStore : update request status and apply allowed anonymize/export lifecycle
    PrivacyStore --> PrivacySvc : completed request
    PrivacySvc --> Api : payload
    Api --> Admin : review outcome
  end
end

@enduml

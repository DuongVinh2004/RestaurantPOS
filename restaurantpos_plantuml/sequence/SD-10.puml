@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam SequenceMessageAlign center
skinparam maxMessageSize 140
autonumber

title SD-10 - Check-in reservation hoặc mở service session walk-in

actor "Nhân viên" as Staff
boundary "Staff Client / Table Board" as Client
boundary "StaffReservationCheckInController" as CheckInApi
boundary "StaffServiceSessionController" as SessionApi
control "StaffCheckInService" as CheckInSvc
control "StaffServiceSessionService" as SessionSvc
database "reservations + reservation_tables + restaurant_tables" as Store

Staff -> Client : chọn reservation check-in hoặc walk-in table

alt reservation check-in
  Client -> CheckInApi : POST /api/v1/staff/reservations/:id/check-in
  CheckInApi -> CheckInSvc : checkIn(reservation_id, table_ids, checked_in_at, row_version)
  CheckInSvc -> Store : lock reservation + assigned tables, validate branch scope
  alt reservation not eligible / stale row_version / table conflict
    Store --> CheckInSvc : reject
    CheckInSvc --> CheckInApi : denied
    CheckInApi --> Client : business rule error
  else eligible
    Store --> CheckInSvc : reservation ready
    CheckInSvc -> Store : mark checked_in_at + sync occupied table state
    Store --> CheckInSvc : checked-in reservation
    CheckInSvc --> CheckInApi : reservation payload
    CheckInApi --> Client : reservation checked-in
  end
else walk-in service session
  Client -> SessionApi : POST /api/v1/staff/service-sessions/walk-in
  SessionApi -> SessionSvc : createWalkInSession(payload, staff_user_id)
  SessionSvc -> Store : validate table availability + branch scope
  alt table unavailable / branch denied
    Store --> SessionSvc : reject
    SessionSvc --> SessionApi : denied
    SessionApi --> Client : business rule error
  else available
    Store --> SessionSvc : table free
    SessionSvc -> Store : create reservation-backed service session + occupy table
    Store --> SessionSvc : active service session
    SessionSvc --> SessionApi : reservation payload
    SessionApi --> Client : walk-in session opened
  end
end

@enduml

@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam SequenceMessageAlign center
skinparam maxMessageSize 140
autonumber

title SD-18 - Inventory / purchasing / kitchen config

actor "Quản trị viên" as Admin
boundary "Admin Client" as Client
boundary "admin.php inventory / purchasing / kitchen routes" as Api
control "AdminInventoryService" as InventorySvc
control "AdminPurchasingService" as PurchasingSvc
control "Kitchen config service" as KitchenCfg
database "ingredients + ingredient_stock_movements\n+ purchase_orders + purchase_order_lines\n+ purchase_receipts + purchase_receipt_lines\n+ kitchen_stations + kitchen_station_category_routes" as OpsStore

alt inventory adjustment / stock ledger
  Admin -> Client : create inventory movement
  Client -> Api : inventory endpoint
  Api -> InventorySvc : validate ingredient/branch command
  InventorySvc -> OpsStore : write ingredient_stock_movements
  OpsStore --> InventorySvc : movement recorded
  InventorySvc --> Api : payload
  Api --> Client : inventory updated
else purchasing flow
  Admin -> Client : create PO / receipt
  Client -> Api : purchasing endpoint
  Api -> PurchasingSvc : validate supplier/order/receipt data
  PurchasingSvc -> OpsStore : write purchase_orders / lines / receipts / receipt lines
  alt invalid PO/receipt linkage
    OpsStore --> PurchasingSvc : reject
    PurchasingSvc --> Api : error
    Api --> Client : purchasing denied
  else success
    OpsStore --> PurchasingSvc : persisted purchasing aggregate
    PurchasingSvc --> Api : payload
    Api --> Client : purchasing success
  end
else kitchen routing config
  Admin -> Client : update station/category routing
  Client -> Api : kitchen config endpoint
  Api -> KitchenCfg : validate station/category mapping
  KitchenCfg -> OpsStore : write kitchen_stations / kitchen_station_category_routes
  OpsStore --> KitchenCfg : persisted config
  KitchenCfg --> Api : payload
  Api --> Client : kitchen config updated
end

@enduml

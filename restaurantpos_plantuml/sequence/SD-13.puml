@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam SequenceMessageAlign center
skinparam maxMessageSize 140
autonumber

title SD-13 - Dispatch bếp và cập nhật vòng đời ticket

actor "Nhân viên" as Staff
actor "Nhân viên bếp" as KitchenStaff
boundary "StaffKitchenController" as KitchenApi
control "KitchenRoutingService" as KitchenSvc
database "kitchen_order_item_tickets + kitchen_station_category_routes\n+ reservation_order_items + reservations" as KdsStore

alt dispatch order items to kitchen
  Staff -> KitchenApi : POST /api/v1/staff/orders/:order_id/kitchen/dispatch
  KitchenApi -> KitchenSvc : dispatchOrder(order_id, row_version, actor_user_id)
  KitchenSvc -> KdsStore : load order items + active route config + branch scope
  alt order not found / stale row_version / route missing
    KdsStore --> KitchenSvc : reject
    KitchenSvc --> KitchenApi : denied
    KitchenApi --> Staff : dispatch denied
  else dispatchable
    KdsStore --> KitchenSvc : routed item context
    KitchenSvc -> KdsStore : create or reuse kitchen tickets and update ticket counters
    KdsStore --> KitchenSvc : ticket rows
    KitchenSvc --> KitchenApi : dispatch payload
    KitchenApi --> Staff : ticket dispatch result
  end
else fire / bump / recall ticket
  KitchenStaff -> KitchenApi : POST /api/v1/staff/kitchen/tickets/:ticket_id/fire|bump|recall
  KitchenApi -> KitchenSvc : fireTicket / bumpTicket / recallTicket(ticket_id, actor_user_id)
  KitchenSvc -> KdsStore : load ticket + linked order item state
  alt invalid ticket state / transition denied
    KdsStore --> KitchenSvc : reject
    KitchenSvc --> KitchenApi : denied
    KitchenApi --> KitchenStaff : action denied
  else valid transition
    KdsStore --> KitchenSvc : ticket context
    KitchenSvc -> KdsStore : update ticket_status and project item lifecycle when policy requires
    KdsStore --> KitchenSvc : updated ticket
    KitchenSvc --> KitchenApi : ticket payload
    KitchenApi --> KitchenStaff : ticket action result
  end
end

@enduml

@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam SequenceMessageAlign center
skinparam maxMessageSize 140
autonumber

title SD-24 - Mở / xem / đóng cashier shift

actor "Thu ngân / Nhân viên" as Cashier
boundary "StaffCashierShiftController" as ShiftApi
control "StaffCashierShiftService" as ShiftSvc
database "cashier_shifts + payments + branches + users" as ShiftStore

alt list / current / detail
  Cashier -> ShiftApi : GET /api/v1/staff/cashier/shifts\nGET /api/v1/staff/cashier/shifts/current\nGET /api/v1/staff/cashier/shifts/:shift_id
  ShiftApi -> ShiftSvc : paginateShiftHistory / currentOpenShift / findShiftOrFail
  ShiftSvc -> ShiftStore : load cashier-scoped shift rows and payment snapshot
  ShiftStore --> ShiftSvc : shift payload
  ShiftSvc --> ShiftApi : current/history/detail payload
  ShiftApi --> Cashier : shift response
else open shift
  Cashier -> ShiftApi : POST /api/v1/staff/cashier/shifts/open
  ShiftApi -> ShiftSvc : openShift(cashier_user_id, opening_float, currency, terminal_code, branch_id)
  ShiftSvc -> ShiftStore : lock cashier user + current open shift, validate branch eligibility
  alt already has open shift / branch denied
    ShiftStore --> ShiftSvc : reject
    ShiftSvc --> ShiftApi : open denied
    ShiftApi --> Cashier : business rule error
  else can open
    ShiftStore --> ShiftSvc : open allowed
    ShiftSvc -> ShiftStore : create cashier_shifts row with generated shift_code
    ShiftStore --> ShiftSvc : opened shift
    ShiftSvc --> ShiftApi : shift payload
    ShiftApi --> Cashier : shift opened
  end
else close shift
  Cashier -> ShiftApi : POST /api/v1/staff/cashier/shifts/:shift_id/close
  ShiftApi -> ShiftSvc : closeShift(shift_id, actual_cash_amount, row_version, notes)
  ShiftSvc -> ShiftStore : lock shift, validate status Open + row_version
  alt shift not open / row_version mismatch
    ShiftStore --> ShiftSvc : reject
    ShiftSvc --> ShiftApi : close denied
    ShiftApi --> Cashier : business rule error
  else closeable
    ShiftStore --> ShiftSvc : open shift context
    ShiftSvc -> ShiftStore : build payment snapshot and expected cash amount
    ShiftStore --> ShiftSvc : expected cash snapshot
    ShiftSvc -> ShiftStore : persist closed_at, expected_cash_amount,\nactual_cash_amount and discrepancy
    ShiftStore --> ShiftSvc : closed shift
    ShiftSvc --> ShiftApi : shift payload
    ShiftApi --> Cashier : shift closed
  end
end

@enduml

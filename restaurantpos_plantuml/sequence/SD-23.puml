@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563

autonumber
title SD-23 - Notification outbox dispatch
caption Flow nội bộ của module Notifications: process due rows, re-check preference, resolve channel, ghi attempt evidence và cập nhật outbox state.
skinparam sequenceMessageAlign center
skinparam maxMessageSize 120

actor "Operator / Scheduler" as OperatorScheduler
control "NotificationOutboxService" as OutboxSvc
control "NotificationPreferenceService" as PrefSvc
control "NotificationChannelManager" as ChannelMgr
database "notification_outbox + notification_delivery_attempts" as NotificationStore
collections "Provider Channel" as Provider

OperatorScheduler -> OutboxSvc : notifications:process-outbox / scheduler tick
OutboxSvc -> NotificationStore : lease due rows with processing token
alt no due rows
  NotificationStore --> OutboxSvc : empty batch
  OutboxSvc --> OperatorScheduler : 0 processed
else due rows found
  NotificationStore --> OutboxSvc : leased rows
  loop for each leased row
    OutboxSvc -> PrefSvc : evaluate(recipient_user_id, channel, now, preferred_timezone)
    alt channel disabled by user
      PrefSvc --> OutboxSvc : enabled = false
      OutboxSvc -> NotificationStore : keep suppressed outcome / no new send
    else quiet hours active
      PrefSvc --> OutboxSvc : quiet_until
      OutboxSvc -> NotificationStore : update next_retry_at = quiet_until
    else send now
      PrefSvc --> OutboxSvc : enabled = true
      OutboxSvc -> ChannelMgr : resolve(channel) + describe(channel)
      alt channel disabled / driver unsupported
        ChannelMgr --> OutboxSvc : non-retryable delivery exception
        OutboxSvc -> NotificationStore : insert attempt + update outbox = Cancelled
      else driver ready
        ChannelMgr -> Provider : send(message)
        alt provider accepted
          Provider --> ChannelMgr : provider_message_id + status
          ChannelMgr --> OutboxSvc : success result
          OutboxSvc -> NotificationStore : insert attempt = Succeeded
          OutboxSvc -> NotificationStore : update outbox = Sent
        else retryable failure
          Provider --> ChannelMgr : transient failure
          ChannelMgr --> OutboxSvc : retryable delivery exception
          OutboxSvc -> NotificationStore : insert attempt = Failed
          OutboxSvc -> NotificationStore : bump attempt_count + update next_retry_at
        else terminal failure
          Provider --> ChannelMgr : permanent failure
          ChannelMgr --> OutboxSvc : non-retryable delivery exception
          OutboxSvc -> NotificationStore : insert attempt = Failed or Suppressed
          OutboxSvc -> NotificationStore : update outbox = Cancelled
        end
      end
    end
  end
  OutboxSvc --> OperatorScheduler : processed count
end
@enduml

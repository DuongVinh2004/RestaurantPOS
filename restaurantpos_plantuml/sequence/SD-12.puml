@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam SequenceMessageAlign center
skinparam maxMessageSize 140
autonumber

title SD-12 - Tạo order và cập nhật món

actor "Nhân viên" as Staff
boundary "Staff Client" as Client
boundary "staff_pos order route/controller" as Api
control "StaffTableOrderService" as OrderSvc
control "Menu validator" as MenuValidator
control "Bill engine" as BillEngine
database "reservation_orders + reservation_order_items\n+ menu_items" as OrderStore

Staff -> Client : tạo order hoặc thêm món vào active order
Client -> Api : submit order mutation

alt create new active order
  Api -> OrderSvc : resolve service context / reservation context
  OrderSvc -> OrderStore : read existing active order for context
  alt active order already exists
    OrderStore --> OrderSvc : existing active order
    OrderSvc --> Api : reuse active order
    Api --> Client : active order returned
  else no active order
    OrderStore --> OrderSvc : none
    OrderSvc -> OrderStore : insert reservation_orders row
    OrderStore --> OrderSvc : active order created
    OrderSvc --> Api : order created
    Api --> Client : active order response
  end
else append / mutate items
  Api -> OrderSvc : add/update order item
  OrderSvc -> MenuValidator : validate item_id + quantity + sellability
  MenuValidator -> OrderStore : read menu item + current order state
  alt invalid item / unavailable item
    OrderStore --> MenuValidator : reject
    MenuValidator --> OrderSvc : denied
    OrderSvc --> Api : error
    Api --> Client : item mutation denied
  else item valid
    OrderStore --> MenuValidator : menu item + order state
    MenuValidator --> OrderSvc : continue
    OrderSvc -> OrderStore : insert/update reservation_order_items
    OrderStore --> OrderSvc : updated order items
    OrderSvc -> BillEngine : recompute bill draft / totals
    BillEngine -> OrderStore : read item lines + prices
    alt bill locked / order not mutable
      OrderStore --> BillEngine : locked state
      BillEngine --> OrderSvc : deny mutation outcome
      OrderSvc --> Api : error
      Api --> Client : bill locked / mutation denied
    else bill draft updated
      OrderStore --> BillEngine : mutable order
      BillEngine --> OrderSvc : updated draft totals
      OrderSvc --> Api : active order + bill draft
      Api --> Client : updated order response
    end
  end
end

@enduml

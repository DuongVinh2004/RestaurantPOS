@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam SequenceMessageAlign center
skinparam maxMessageSize 140
autonumber

title SD-11 - Gán bàn / đổi bàn / giải phóng bàn

actor "Nhân viên" as Staff
boundary "Staff Client / Table Board" as Client
boundary "StaffReservationBoardAssignmentController" as AssignApi
boundary "StaffReservationMoveTableController" as MoveApi
boundary "StaffTableReleaseController" as ReleaseApi
control "StaffReservationBoardAssignmentService" as AssignSvc
control "StaffMoveTableService" as MoveSvc
control "StaffTableReleaseService" as ReleaseSvc
database "reservations + reservation_tables + restaurant_tables\n+ reservation_orders" as Store

Staff -> Client : thao tác assign, move hoặc release table

alt assign suggested / best-fit
  Client -> AssignApi : POST /api/v1/staff/reservations/:id/assign-table|assign-best-fit
  AssignApi -> AssignSvc : assignSuggestedTable / assignBestFit(...)
  AssignSvc -> Store : lock reservation + target tables, validate row_version and board candidates
  alt reservation not Confirmed / stale row_version / candidate conflict
    Store --> AssignSvc : reject
    AssignSvc --> AssignApi : denied
    AssignApi --> Client : assign denied
  else assignable
    Store --> AssignSvc : candidate table set
    AssignSvc -> Store : persist reservation_tables mutation
    Store --> AssignSvc : updated board state
    AssignSvc --> AssignApi : reservation + assignment meta
    AssignApi --> Client : table assigned
  end
else move table
  Client -> MoveApi : POST /api/v1/staff/reservations/:id/move-table
  MoveApi -> MoveSvc : move(reservation_id, from_table_id, to_table_id, moved_at, row_version)
  MoveSvc -> Store : lock reservation + source/target tables
  alt reservation not checked-in / stale row_version / target conflict
    Store --> MoveSvc : reject
    MoveSvc --> MoveApi : denied
    MoveApi --> Client : move denied
  else movable
    Store --> MoveSvc : source/target valid
    MoveSvc -> Store : switch reservation_tables and table occupancy safely
    Store --> MoveSvc : moved reservation
    MoveSvc --> MoveApi : reservation payload
    MoveApi --> Client : table moved
  end
else release table
  Client -> ReleaseApi : POST /api/v1/staff/tables/:table_id/release
  ReleaseApi -> ReleaseSvc : release(table_id, force, notes, row_version)
  ReleaseSvc -> Store : lock table + active reservation/order context
  alt blocking reservation / live order / row_version mismatch
    Store --> ReleaseSvc : reject
    ReleaseSvc --> ReleaseApi : denied
    ReleaseApi --> Client : release denied
  else releasable
    Store --> ReleaseSvc : release context
    ReleaseSvc -> Store : release table state safely
    Store --> ReleaseSvc : released table
    ReleaseSvc --> ReleaseApi : table payload
    ReleaseApi --> Client : table released
  end
end

@enduml

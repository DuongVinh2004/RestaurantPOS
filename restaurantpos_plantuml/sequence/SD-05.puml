@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam SequenceMessageAlign center
skinparam maxMessageSize 140
autonumber

title SD-05 - Tạo reservation

actor "Khách hàng / Nhân viên" as User
boundary "Booking Client" as Client
boundary "POST /api/v1/reservations\nReservationController@store" as Api
boundary "CustomerOrStaffMiddleware" as ScopeMw
control "redis.throttle:reservations.store" as Throttle
control "Idempotency middleware\nidempotency:reservations" as Idempotency
control "ReservationService" as ReservationSvc
control "Hold/Conflict validator" as Validator
database "reservations + reservation_tables\n+ table_holds + restaurant_tables" as ReservationStore

User -> Client : xác nhận create reservation
Client -> Api : POST /reservations
Api -> ScopeMw : resolve customer/staff caller contract
Api -> Throttle : throttle reservation create
Api -> Idempotency : check request replay
alt replayed request
  Idempotency --> Api : previous response
  Api --> Client : existing reservation payload
else new request
  Idempotency --> Api : continue
  Api -> ReservationSvc : create reservation command
  alt create from hold
    ReservationSvc -> Validator : validate hold ownership + expiry + branch consistency
    Validator -> ReservationStore : load hold + held tables
  else create from direct table selection
    ReservationSvc -> Validator : validate selected tables + slot policy + conflicts
    Validator -> ReservationStore : read table occupancy / conflicts
  end
  alt hold invalid / double-book / slot denied
    ReservationStore --> Validator : reject
    Validator --> ReservationSvc : validation failed
    ReservationSvc --> Api : error
    Api --> Client : reservation denied
  else validation passed
    ReservationStore --> Validator : ok
    Validator --> ReservationSvc : reservation can be created
    ReservationSvc -> ReservationStore : insert reservation + reservation_tables\nand link/consume hold when applicable
    ReservationStore --> ReservationSvc : reservation aggregate
    ReservationSvc --> Api : created reservation
    Api --> Client : reservation created
  end
end

opt show reservation
  Client -> Api : GET /reservations/:id
  Api -> ScopeMw : resolve customer/staff scope
  Api -> ReservationSvc : load reservation detail
  ReservationSvc -> ReservationStore : read reservation + assigned tables
  ReservationStore --> ReservationSvc : reservation detail
  ReservationSvc --> Api : payload
  Api --> Client : reservation detail
end

@enduml

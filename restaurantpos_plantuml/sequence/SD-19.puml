@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam SequenceMessageAlign center
skinparam maxMessageSize 140
autonumber

title SD-19 - Conversation inbox

actor "Nhân viên" as Staff
boundary "Staff Client / Inbox" as Client
boundary "staff_pos conversation route/controller" as Api
control "StaffConversationInboxService" as InboxSvc
control "Assignment / queue workflow" as Workflow
database "conversations + agent_assignments\n+ conversation_messages + conversation_events\n+ conversation_analyses + notification_outbox" as InboxStore

alt list / open conversation
  Staff -> Client : open inbox or conversation
  Client -> Api : list/show conversation endpoints
  Api -> InboxSvc : load inbox queue
  InboxSvc -> InboxStore : read conversations + assignments + linked business subjects
  InboxStore --> InboxSvc : inbox data
  InboxSvc --> Api : payload
  Api --> Client : inbox response
else assign / reassign / workflow action
  Staff -> Client : assign or change workflow
  Client -> Api : assignment/workflow endpoint
  Api -> Workflow : validate assignee + queue state
  Workflow -> InboxStore : write agent_assignments / conversation_events
  InboxStore --> Workflow : updated workflow state
  Workflow --> Api : payload
  Api --> Client : workflow updated
else send message / internal note
  Staff -> Client : reply or note
  Client -> Api : message endpoint
  Api -> InboxSvc : validate conversation state
  InboxSvc -> InboxStore : insert conversation_messages / files / entities
  InboxStore --> InboxSvc : stored message
  opt outbound support / notification side effect
    InboxSvc ->> InboxStore : enqueue notification_outbox / async follow-up
  end
  InboxSvc --> Api : payload
  Api --> Client : message stored
end

@enduml

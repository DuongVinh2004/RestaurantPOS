@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam SequenceMessageAlign center
skinparam maxMessageSize 140
autonumber

title SD-22 - Health / metrics / release readiness

actor "Operator" as Operator
participant "CLI / Composer scripts" as CLI
boundary "HealthController" as HealthApi
boundary "MetricsController" as MetricsApi
control "OpsHeartbeatService + OperationalInsightsService" as HealthSvc
database "runtime dependencies\n(MySQL / Redis / scheduler heartbeat\n+ notification outbox + release artifacts)" as Runtime

alt basic / detailed / redis health
  Operator -> HealthApi : GET /api/v1/health\nGET /api/v1/health/detailed\nGET /api/v1/health/redis
  HealthApi -> HealthSvc : runtimeSnapshot / redisSnapshot / operational insights
  HealthSvc -> Runtime : probe DB, Redis, scheduler heartbeat and ops checks
  Runtime --> HealthSvc : probe results
  HealthSvc --> HealthApi : status + checks payload
  HealthApi --> Operator : health response
else metrics
  Operator -> MetricsApi : GET /api/v1/metrics
  MetricsApi -> Runtime : read metrics store / counters
  Runtime --> MetricsApi : metric values
  MetricsApi --> Operator : Prometheus text payload
else CLI release / contract workflow
  Operator -> CLI : php artisan booking:doctor --json\nphp artisan booking:deploy-check --mode=preflight\nphp artisan booking:release-manifest --json\nphp artisan notifications:outbox-health --json
  CLI -> Runtime : inspect schema contract, runtime prerequisites and release artifacts
  Runtime --> CLI : pass/fail evidence
  CLI --> Operator : console/report output
end

@enduml

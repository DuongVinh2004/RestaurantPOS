@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam SequenceMessageAlign center
skinparam maxMessageSize 140
autonumber

title SD-16 - Áp dụng voucher / loyalty / benefits

actor "Khách hàng / Nhân viên" as User
boundary "CustomerReservationBenefitsActionController\n+ staff benefits route/controller" as Api
control "Benefits preview / validation service" as BenefitsSvc
control "Voucher service" as VoucherSvc
control "Loyalty service" as LoyaltySvc
database "reservations + user_vouchers\n+ user_points + loyalty_point_transactions" as BenefitStore

alt benefits preview
  User -> Api : open benefits preview
  Api -> BenefitsSvc : load reservation benefit context
  BenefitsSvc -> BenefitStore : read reservation + available voucher/loyalty state
  BenefitStore --> BenefitsSvc : preview context
  BenefitsSvc --> Api : preview payload
  Api --> User : preview response
else apply / remove voucher
  User -> Api : apply or remove voucher
  Api -> VoucherSvc : validate voucher applicability
  VoucherSvc -> BenefitStore : read reservation, voucher, lock/payment state
  alt voucher expired / unavailable / bill locked
    BenefitStore --> VoucherSvc : reject
    VoucherSvc --> Api : denied
    Api --> User : business rule error
  else valid voucher mutation
    BenefitStore --> VoucherSvc : continue
    VoucherSvc -> BenefitStore : update applied_user_voucher_id / release lock
    BenefitStore --> VoucherSvc : updated reservation/voucher state
    VoucherSvc --> Api : payload
    Api --> User : voucher updated
  end
else redeem / release loyalty
  User -> Api : redeem or release loyalty
  Api -> LoyaltySvc : validate points + reservation/payment state
  LoyaltySvc -> BenefitStore : read user_points + reservation + prior loyalty txns
  alt insufficient points / state denied / bill locked
    BenefitStore --> LoyaltySvc : reject
    LoyaltySvc --> Api : denied
    Api --> User : business rule error
  else valid loyalty mutation
    BenefitStore --> LoyaltySvc : continue
    LoyaltySvc -> BenefitStore : write loyalty_point_transactions\nand update reservation loyalty state
    BenefitStore --> LoyaltySvc : updated loyalty state
    LoyaltySvc --> Api : payload
    Api --> User : loyalty updated
  end
end

@enduml

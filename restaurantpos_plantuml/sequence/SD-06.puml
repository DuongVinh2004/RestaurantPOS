@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam SequenceMessageAlign center
skinparam maxMessageSize 140
autonumber

title SD-06 - Khách tự quản lý reservation

actor "Khách hàng" as Customer
boundary "Customer Client" as Client
boundary "CustomerReservationSelfServiceController" as SelfApi
control "Owner scope guard" as OwnerGuard
control "ReservationService" as ReservationSvc
control "BranchSchedulingPolicyService" as Policy
database "reservations + reservation_tables\n+ branches" as ReservationStore

alt list reservations
  Customer -> Client : mở màn hình reservation self-service
  Client -> SelfApi : GET /reservations
  SelfApi -> OwnerGuard : resolve owner/session scope
  OwnerGuard -> ReservationStore : query reservations in current owner scope
  ReservationStore --> OwnerGuard : reservation list
  OwnerGuard --> SelfApi : allowed reservations
  SelfApi --> Client : list response
else cancel reservation
  Customer -> Client : yêu cầu hủy reservation
  Client -> SelfApi : POST /reservations/:id/cancel
  SelfApi -> OwnerGuard : verify reservation ownership
  OwnerGuard -> ReservationStore : load reservation
  alt owner scope denied
    ReservationStore --> OwnerGuard : deny
    OwnerGuard --> SelfApi : forbidden
    SelfApi --> Client : 403 / 404
  else owner ok
    ReservationStore --> OwnerGuard : reservation
    OwnerGuard --> SelfApi : continue
    SelfApi -> Policy : validate cancel cutoff / status
    Policy -> ReservationStore : read branch policy + reservation state
    alt cutoff denied / state denied
      ReservationStore --> Policy : reject
      Policy --> SelfApi : cancel denied
      SelfApi --> Client : business rule error
    else cancellable
      ReservationStore --> Policy : ok
      Policy --> SelfApi : continue
      SelfApi -> ReservationSvc : cancel reservation
      ReservationSvc -> ReservationStore : update status + release relevant state
      ReservationStore --> ReservationSvc : cancelled reservation
      ReservationSvc --> SelfApi : payload
      SelfApi --> Client : cancelled
    end
  end
else reschedule reservation
  Customer -> Client : yêu cầu đổi lịch
  Client -> SelfApi : POST /reservations/:id/reschedule
  SelfApi -> OwnerGuard : verify owner/session scope
  OwnerGuard -> ReservationStore : load reservation
  alt owner scope denied
    ReservationStore --> OwnerGuard : deny
    OwnerGuard --> SelfApi : forbidden
    SelfApi --> Client : 403 / 404
  else owner ok
    ReservationStore --> OwnerGuard : reservation
    OwnerGuard --> SelfApi : continue
    SelfApi -> Policy : validate new slot / cutoff / branch policy
    Policy -> ReservationStore : read policy + conflicts
    alt new slot invalid / cutoff denied / conflict
      ReservationStore --> Policy : reject
      Policy --> SelfApi : reschedule denied
      SelfApi --> Client : business rule error
    else reschedulable
      ReservationStore --> Policy : ok
      Policy --> SelfApi : continue
      SelfApi -> ReservationSvc : reschedule reservation
      ReservationSvc -> ReservationStore : update reservation + reservation_tables
      ReservationStore --> ReservationSvc : rescheduled aggregate
      ReservationSvc --> SelfApi : payload
      SelfApi --> Client : rescheduled
    end
  end
end

@enduml

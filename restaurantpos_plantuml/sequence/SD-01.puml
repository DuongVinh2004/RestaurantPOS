@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam SequenceMessageAlign center
skinparam maxMessageSize 140
autonumber

title SD-01 - Đăng nhập khách hàng

actor "Khách hàng" as Customer
boundary "Customer Client" as Client
boundary "CustomerAuthController" as AuthApi
control "Throttle middleware\ncustomer_auth.login_throttle_*" as Throttle
control "OpaqueProductAuthService" as AuthSvc
database "users + customer_access_sessions" as SessionStore
boundary "ResolveCustomerAuthMiddleware" as ResolveAuth

Customer -> Client : nhập identifier, password và session/device metadata
Client -> AuthApi : POST /api/v1/auth/customer/login
AuthApi -> Throttle : check login throttle window / limit
alt throttle exceeded
  Throttle --> AuthApi : reject
  AuthApi --> Client : 429 / auth error
else throttle ok
  Throttle --> AuthApi : continue
  AuthApi -> AuthSvc : loginCustomer(identifier, password, metadata)
  AuthSvc -> SessionStore : resolve customer user + issue access session
  alt invalid credential / wrong role
    SessionStore --> AuthSvc : deny
    AuthSvc --> AuthApi : validation error
    AuthApi --> Client : 401 / 422
  else authenticated
    SessionStore --> AuthSvc : customer + access session + token
    AuthSvc --> AuthApi : customer session payload
    AuthApi --> Client : X-Customer-Token + session payload
  end
end

opt authenticated customer session routes
  Client -> ResolveAuth : attach X-Customer-Token
  ResolveAuth -> SessionStore : resolve active customer_access_session
  alt token invalid / revoked
    SessionStore --> ResolveAuth : authentication required
    ResolveAuth --> Client : 401
  else token valid
    SessionStore --> ResolveAuth : customer_access_session_id
    ResolveAuth --> Client : request authenticated
    alt current customer
      Client -> AuthApi : GET /api/v1/auth/customer/me
      AuthApi -> AuthSvc : currentCustomer(customer_access_session_id)
      AuthSvc -> SessionStore : load active session + user
      SessionStore --> AuthSvc : current customer
      AuthSvc --> AuthApi : me payload
      AuthApi --> Client : current session/user
    else refresh session
      Client -> AuthApi : POST /api/v1/auth/customer/refresh
      AuthApi -> AuthSvc : refreshCustomer(customer_access_session_id)
      AuthSvc -> SessionStore : revoke current session + issue replacement
      SessionStore --> AuthSvc : refreshed access session
      AuthSvc --> AuthApi : refreshed payload
      AuthApi --> Client : refreshed token/session
    else logout session
      Client -> AuthApi : POST /api/v1/auth/customer/logout
      AuthApi -> AuthSvc : logoutCustomer(customer_access_session_id)
      AuthSvc -> SessionStore : revoke access session
      SessionStore --> AuthSvc : revoked
      AuthSvc --> AuthApi : logout payload
      AuthApi --> Client : logout success
    end
  end
end

@enduml

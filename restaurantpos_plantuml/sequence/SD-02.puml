@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam SequenceMessageAlign center
skinparam maxMessageSize 140
autonumber

title SD-02 - Đăng nhập nhân viên / quản trị

actor "Nhân viên / Quản trị viên" as Staff
boundary "Staff Client" as Client
boundary "StaffAuthController" as AuthApi
control "Throttle middleware\nstaff_auth.login_throttle_*" as Throttle
control "OpaqueProductAuthService" as AuthSvc
database "users + roles + staff_api_keys + cashier_shifts" as StaffStore
boundary "StaffApiKeyMiddleware" as StaffKeyMw
control "Capability guard\nstaff.capability:*" as Capability

Staff -> Client : nhập identifier, password và label/device_name
Client -> AuthApi : POST /api/v1/auth/staff/login
AuthApi -> Throttle : check login throttle
alt throttle exceeded
  Throttle --> AuthApi : reject
  AuthApi --> Client : 429 / auth error
else throttle ok
  Throttle --> AuthApi : continue
  AuthApi -> AuthSvc : loginStaff(identifier, password, metadata)
  AuthSvc -> StaffStore : resolve internal role + issue staff API key
  alt invalid credential / wrong role
    StaffStore --> AuthSvc : deny
    AuthSvc --> AuthApi : validation error
    AuthApi --> Client : 401 / 422
  else authenticated
    StaffStore --> AuthSvc : staff API key + workspace/capability context
    AuthSvc --> AuthApi : staff session payload
    AuthApi --> Client : X-Staff-Key + actor context
  end
end

opt authenticated staff routes
  Client -> StaffKeyMw : attach X-Staff-Key
  StaffKeyMw -> StaffStore : resolve active staff_api_key
  alt key invalid / revoked
    StaffStore --> StaffKeyMw : authentication required
    StaffKeyMw --> Client : 401
  else key valid
    StaffStore --> StaffKeyMw : staff_api_key_id + actor context
    StaffKeyMw --> Client : request authenticated
    alt current staff
      Client -> AuthApi : GET /api/v1/auth/staff/me
      AuthApi -> AuthSvc : currentStaff(staff_api_key_id)
      AuthSvc -> StaffStore : load actor + current shift/workspace context
      StaffStore --> AuthSvc : actor payload
      AuthSvc --> AuthApi : me payload
      AuthApi --> Client : current actor
    else refresh staff session
      Client -> AuthApi : POST /api/v1/auth/staff/refresh
      AuthApi -> AuthSvc : refreshStaff(staff_api_key_id)
      AuthSvc -> StaffStore : rotate staff API key
      StaffStore --> AuthSvc : replacement key
      AuthSvc --> AuthApi : refreshed payload
      AuthApi --> Client : refreshed key/session
    else logout staff session
      Client -> AuthApi : POST /api/v1/auth/staff/logout
      AuthApi -> AuthSvc : logoutStaff(staff_api_key_id)
      AuthSvc -> StaffStore : revoke key
      StaffStore --> AuthSvc : revoked
      AuthSvc --> AuthApi : logout payload
      AuthApi --> Client : logout success
    end
  end
end

opt calling protected staff/admin routes
  Client -> StaffKeyMw : X-Staff-Key
  StaffKeyMw -> Capability : resolve staff capability map
  alt capability denied
    Capability --> Client : 403 forbidden
  else capability allowed
    Capability --> Client : proceed to route controller
  end
end

@enduml

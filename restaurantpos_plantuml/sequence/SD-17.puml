@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam SequenceMessageAlign center
skinparam maxMessageSize 140
autonumber

title SD-17 - Admin master data / branch policy

actor "Quản trị viên" as Admin
boundary "Admin Client" as Client
boundary "admin.php route/controller set\nbranch/menu/table/voucher/loyalty/settings" as Api
control "AdminMasterDataBulk + domain CRUD services" as MasterData
control "Import/Export batch processor" as Bulk
database "branches + restaurant_tables + menu_*\n+ vouchers + loyalty_* + settings" as MasterStore

alt CRUD master data
  Admin -> Client : create/update/delete master data
  Client -> Api : call admin CRUD endpoint
  Api -> MasterData : validate capability + payload
  MasterData -> MasterStore : read/write target domain tables
  alt validation failed / duplicate / invalid policy
    MasterStore --> MasterData : reject
    MasterData --> Api : error
    Api --> Client : CRUD denied
  else success
    MasterStore --> MasterData : persisted
    MasterData --> Api : payload
    Api --> Client : CRUD success
  end
else import / export
  Admin -> Client : run export or import
  Client -> Api : upload file / request export
  Api -> Bulk : analyze domain file / assemble export
  alt dry-run import
    Bulk -> MasterStore : validate schema/mapping only
    MasterStore --> Bulk : dry-run result
    Bulk --> Api : can_commit / errors / changes
    Api --> Client : dry-run report
  else commit import
    Bulk -> MasterStore : transactional write for approved batch
    MasterStore --> Bulk : committed batch
    Bulk --> Api : import result
    Api --> Client : commit success
  else export
    Bulk -> MasterStore : read domain dataset
    MasterStore --> Bulk : export rows
    Bulk --> Api : export artifact
    Api --> Client : downloadable export
  end
end

@enduml

@startuml
skinparam Shadowing false
skinparam DefaultFontName Arial
skinparam BackgroundColor white
skinparam ArrowColor #4B5563
skinparam SequenceMessageAlign center
skinparam maxMessageSize 140
autonumber

title SD-14 - Khóa bill và hoàn tất checkout

actor "Nhân viên / Thu ngân" as Cashier
boundary "Staff Client" as Client
boundary "staff_pos checkout route/controller" as Api
control "StaffCheckoutService" as CheckoutSvc
control "OrderSettlementService" as SettlementSvc
control "ReservationFinancialSyncService" as SyncSvc
database "reservation_orders + payments\n+ billing_invoices + cashier_shifts\n+ finance_replay_records" as FinanceStore

Cashier -> Client : mở checkout cho reservation/order
Client -> Api : close / preview / pay / finalize

alt settlement preview / bill lock
  Api -> CheckoutSvc : create bill snapshot / lock bill
  CheckoutSvc -> FinanceStore : read order lines + current payments
  alt bill not lockable / order still mutable
    FinanceStore --> CheckoutSvc : reject
    CheckoutSvc --> Api : preview denied
    Api --> Client : business rule error
  else lockable
    FinanceStore --> CheckoutSvc : bill context
    CheckoutSvc -> SettlementSvc : compute settlement preview
    SettlementSvc -> FinanceStore : read totals / discounts / paid / outstanding
    FinanceStore --> SettlementSvc : monetary context
    SettlementSvc --> CheckoutSvc : preview payload
    CheckoutSvc --> Api : preview response
    Api --> Client : settlement preview
  end
else pay / finalize
  Api -> CheckoutSvc : apply payment / finalize checkout
  CheckoutSvc -> SettlementSvc : validate outstanding + payment command
  SettlementSvc -> FinanceStore : read reservation/order/payment lineage
  alt invalid payment data / outstanding mismatch
    FinanceStore --> SettlementSvc : reject
    SettlementSvc --> CheckoutSvc : denied
    CheckoutSvc --> Api : error
    Api --> Client : finalize denied
  else settlement valid
    FinanceStore --> SettlementSvc : continue
    SettlementSvc -> FinanceStore : write payments / invoice / shift linkage
    FinanceStore --> SettlementSvc : payment + invoice state
    SettlementSvc -> SyncSvc : project financial result to reservation/order state
    SyncSvc -> FinanceStore : update reservation/order completion status
    FinanceStore --> SyncSvc : synced state
    SyncSvc --> SettlementSvc : final aggregate
    SettlementSvc --> CheckoutSvc : final outcome
    CheckoutSvc --> Api : paid / pending / completed
    Api --> Client : checkout result
  end
end

@enduml

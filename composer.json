{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "duongvinh2004/restaurantpos",
    "type": "project",
    "description": "SQL-first Laravel backend for RestaurantPOS reservations, POS, checkout, inventory, and ops tooling.",
    "keywords": [
        "laravel",
        "restaurant",
        "pos",
        "booking",
        "inventory"
    ],
    "license": "MIT",
    "homepage": "https://github.com/DuongVinh2004/RestaurantPOS",
    "support": {
        "issues": "https://github.com/DuongVinh2004/RestaurantPOS/issues",
        "source": "https://github.com/DuongVinh2004/RestaurantPOS",
        "docs": "https://github.com/DuongVinh2004/RestaurantPOS/tree/main/docs/runbooks",
        "security": "https://github.com/DuongVinh2004/RestaurantPOS/security/advisories/new"
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.9",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5.3",
        "reliese/laravel": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "bootstrap:release-db": [
            "@php tools/mysql/bootstrap_release.php"
        ],
        "bootstrap:booking": [
            "@php tools/bootstrap_booking.php"
        ],
        "api:artifacts": [
            "@php artisan booking:api-contract --write",
            "@php artisan booking:api-artifacts:generate",
            "@php artisan booking:release-manifest --write"
        ],
        "release:package": [
            "@php artisan booking:release-build"
        ],
        "release:go-live-check": [
            "Composer\\Config::disableProcessTimeout",
            "node scripts/release/go-live-check.mjs"
        ],
        "release:loop": [
            "@php artisan booking:release-loop"
        ],
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi --force",
            "@php tools/bootstrap_booking.php",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "test:security": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@php artisan test tests/Feature/Security/SecurityAuthRbacBranchIsolationLadderTest.php tests/Feature/Staff/StaffBranchScopeSecurityHardeningTest.php tests/Feature/Staff/StaffCapabilityHttpGuardTest.php tests/Feature/Infrastructure/OpsReleaseAuthorizationMatrixTest.php tests/Unit/Http/Middleware/RequireStaffCapabilityTest.php tests/Unit/Support/StaffCapabilityResolverTest.php tests/Unit/Support/StaffApiKeyActorResolverTest.php"
        ],
        "test:orders": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@php artisan test tests/Feature/Staff/StaffOrderCriticalFlowHttpTest.php tests/Feature/Staff/StaffOrderItemLifecycleFlowTest.php tests/Feature/Staff/StaffOrderReadFlowTest.php tests/Feature/Staff/StaffTableOrderBranchScopeTest.php tests/Feature/Staff/StaffTableOrderConcurrencyGuardServiceTest.php tests/Feature/Staff/StaffTableOrderIdempotencyReplayServiceTest.php tests/Unit/Domain/Policies/ReservationOrderItemStatusTransitionPolicyTest.php tests/Unit/Services/Staff/BillLockServiceTest.php"
        ],
        "test:kitchen": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@php artisan test tests/Feature/Staff/StaffKitchenDispatchFoundationFlowTest.php tests/Feature/Admin/AdminKitchenRoutingFoundationHttpFlowTest.php tests/Feature/Staff/StaffOrderKdsFohActorBoundaryServiceTest.php tests/Feature/Admin/AdminInventoryKitchenPurchasingIdempotencyPolicyTest.php tests/Feature/Admin/AdminInventoryKitchenPurchasingRouteSurfaceTest.php tests/Unit/Domain/Policies/KitchenTicketTransitionPolicyTest.php"
        ],
        "test:money": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@php artisan test tests/Feature/Staff/StaffCheckoutHttpGuardFlowTest.php tests/Feature/Staff/StaffCheckoutConcurrencyGuardFlowTest.php tests/Feature/Staff/StaffCheckoutIdempotencyReplayServiceTest.php tests/Feature/Staff/StaffCheckoutRefundLifecycleTest.php tests/Feature/Staff/StaffCheckoutRefundAllocationGuardTest.php tests/Feature/Staff/StaffCheckoutRefundAndCancelServiceTest.php tests/Feature/Staff/StaffCashierShiftHttpFlowTest.php tests/Feature/Staff/StaffMoneyActorBoundaryServiceTest.php tests/Feature/Staff/StaffBranchScopeSecurityHardeningTest.php tests/Feature/Financial/ReservationPaymentIntegrityFlowTest.php tests/Unit/Domain/Policies/PaymentStatusTransitionPolicyTest.php tests/Unit/Services/Staff/PaymentCaptureServiceTest.php tests/Unit/Services/Staff/RefundExecutionServiceTest.php tests/Unit/Services/Staff/RefundPlannerServiceTest.php tests/Unit/Services/Staff/StaffCashierShiftMoneyTest.php tests/Unit/Support/RefundAllocationPolicyTest.php tests/Unit/Support/PaymentSummaryHardeningTest.php"
        ],
        "test:inventory": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@php artisan test tests/Feature/Admin/AdminInventoryFoundationHttpFlowTest.php tests/Feature/Staff/OrderItemInventoryConsumptionFlowTest.php tests/Feature/Admin/AdminInventoryKitchenPurchasingIdempotencyPolicyTest.php tests/Feature/Admin/AdminInventoryKitchenPurchasingRouteSurfaceTest.php tests/Unit/Services/Inventory/InventoryStockMovementServiceTest.php tests/Unit/Support/RowVersionSourceOfTruthInventoryTest.php"
        ],
        "test:release-contract": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@php artisan test tests/Unit/Config tests/Unit/Infrastructure tests/Unit/Services/BookingEnvironmentValidatorTest.php tests/Unit/Services/BookingReleaseConfigContractTest.php tests/Unit/Services/CoreOpsGateServiceTest.php tests/Unit/Services/DatabaseContractInspectorTest.php tests/Unit/Services/ReleaseArtifactContractTest.php tests/Unit/Services/ReleaseArtifactManifestServiceTest.php tests/Unit/Services/ReleaseArtifactNormalizerServiceTest.php tests/Unit/Services/ReleaseBuildServiceTest.php tests/Unit/Services/ReleaseLoopServiceTest.php tests/Unit/Services/ReleasePackageDefinitionContractTest.php tests/Unit/Services/ReleasePackageServiceTest.php tests/Unit/Services/RoundFiveGateServiceTest.php tests/Unit/Services/RouteInventoryGateServiceTest.php tests/Feature/Console/BookingCoreOpsGateCommandTest.php tests/Feature/Console/BookingDeployCheckCommandTest.php tests/Feature/Console/BookingDoctorCommandTest.php tests/Feature/Console/BookingReleaseBuildCommandTest.php tests/Feature/Console/BookingReleaseManifestCommandTest.php tests/Feature/Console/BookingRouteGateCommandTest.php tests/Feature/Console/BookingRoundFiveGateCommandTest.php tests/Feature/Infrastructure/ApiRouteSurfaceIntegrityTest.php tests/Feature/Infrastructure/ApiOpenApiContractCoverageTest.php"
        ],
        "test:runtime-smoke": [
            "Composer\\Config::disableProcessTimeout",
            "bash scripts/ci/booking-runtime-smoke.sh"
        ],
        "test:phpstan": [
            "Composer\\Config::disableProcessTimeout",
            "bash scripts/ci/booking-phpstan.sh"
        ],
        "test:critical": [
            "Composer\\Config::disableProcessTimeout",
            "@test:security",
            "@test:orders",
            "@test:kitchen",
            "@test:money",
            "@test:inventory",
            "@test:release-contract"
        ],
        "verify:select": [
            "@php artisan booking:verify-select"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"fwrite(STDOUT, 'Run composer bootstrap:booking after configuring your MySQL .env values.'.PHP_EOL);\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "reliese/laravel"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

# ==============================================================================
# RestaurantPOS Staging Environment Template
# ==============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to `/var/www/restaurantpos/.env` on the staging server.
# 2. Replace all <REQUIRED:...> tags with ACTUAL values.
# 3. DO NOT use 'changeme', 'dummy', 'example', 'secret' or placeholders like '123456'.
#    The `LaunchReadinessService` truthfulness gate will fail if it detects them.
# 4. NEVER commit the real `.env` file to version control.
#

APP_NAME="RestaurantPOS Staging"
APP_ENV=staging
APP_DEBUG=false
APP_KEY=<REQUIRED:VALID_BASE64_KEY>
APP_URL=<REQUIRED:STAGING_HTTPS_URL>

# ==============================================================================
# DATABASE (SQL-FIRST)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=<REQUIRED:MYSQL_HOST_IP_OR_HOSTNAME>
DB_PORT=3306
DB_DATABASE=<REQUIRED:MYSQL_DATABASE_NAME>
DB_USERNAME=<REQUIRED:MYSQL_USER>
DB_PASSWORD=<REQUIRED:MYSQL_PASSWORD>

# ==============================================================================
# REDIS (REQUIRED FOR DISTRIBUTED LOCKS AND QUEUES)
# ==============================================================================
REDIS_HOST=<REQUIRED:REDIS_HOST_IP_OR_HOSTNAME>
REDIS_PORT=6379
REDIS_PASSWORD=<OPTIONAL:REDIS_PASSWORD>

# ==============================================================================
# CACHE, QUEUE, SESSION DRIVERS
# ==============================================================================
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# ==============================================================================
# OBSERVABILITY & ALERTING
# ==============================================================================
SENTRY_LARAVEL_DSN=<REQUIRED:REAL_SENTRY_DSN_URL>
OPS_ALERTS_WEBHOOK_URL=<REQUIRED:REAL_SLACK_WEBHOOK_URL_FOR_OPS>
LOG_SLACK_WEBHOOK_URL=<OPTIONAL:REAL_SLACK_WEBHOOK_URL_FOR_LOGGING>

# ==============================================================================
# BACKUPS (AWS S3 OR COMPATIBLE E.G., MINIO)
# ==============================================================================
AWS_ACCESS_KEY_ID=<REQUIRED:AWS_ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<REQUIRED:AWS_SECRET_KEY>
AWS_DEFAULT_REGION=<REQUIRED:AWS_REGION_EG_US_EAST_1>
BACKUP_S3_BUCKET=<REQUIRED:S3_BUCKET_NAME>

# ==============================================================================
# CORS & FRONTEND
# ==============================================================================
CORS_ALLOWED_ORIGINS=<REQUIRED:COMMA_SEPARATED_LIST_OF_ALLOWED_ORIGINS>

# ==============================================================================
# AUTHENTICATION
# ==============================================================================
CUSTOMER_AUTH_JWT_SECRET=<REQUIRED:HIGH_ENTROPY_STRING_MIN_32_CHARS>

# ==============================================================================
# PAYMENT PROVIDERS (OPTIONAL DAY 1, REQUIRED IF BILL SELF PAY IS ON)
# ==============================================================================
PAYMENT_WEBHOOK_SECRET=<OPTIONAL:PAYMENT_WEBHOOK_SECRET>

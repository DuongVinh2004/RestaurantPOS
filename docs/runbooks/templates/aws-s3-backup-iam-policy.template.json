{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowListBucketAndPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::<staging-backup-bucket>"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "<prefix>/*",
            "<prefix>"
          ]
        }
      }
    },
    {
      "Sid": "AllowBackupObjectOperations",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:HeadObject"
      ],
      "Resource": [
        "arn:aws:s3:::<staging-backup-bucket>/<prefix>/*"
      ]
    }
  ]
}

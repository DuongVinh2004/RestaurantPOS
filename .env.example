APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# Keep runtime timestamps in UTC; branch-local operations use BOOKING_DEFAULT_BRANCH_TIMEZONE.
APP_TIMEZONE=UTC

# CORS (cross-origin)
# Comma-separated origins allowed for cross-origin API access.
# Leave empty to deny all cross-origin requests (production default).
# Production-like targets require exact http(s) origins only: no wildcard, path, query, fragment, credentials, or trailing slash.
# Example: http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
CORS_ALLOWED_ORIGINS=
# Keep false unless the staff browser refresh-cookie rollout is enabled for exact allowed origins.
CORS_SUPPORTS_CREDENTIALS=false

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Runtime gate database.
# SQL-first bootstrap requires MySQL 8 compatible runtime plus mysql CLI access.
# Set MYSQL_BIN when mysql is not on PATH; set MYSQLD_BIN only when using the Windows local MySQL helper.
# Local-only fallback: npm run runtime:up may start docker-compose.testing.yml when no local MySQL runtime is reachable.
# MYSQL_DOCKER_CONTAINER can point bootstrap at an already-running local MySQL container when the host lacks mysql.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restaurantdb
DB_USERNAME=root
DB_PASSWORD=
MYSQL_BIN=
MYSQLD_BIN=

# Session/cache/queue runtime storage.
# Local defaults keep API iteration simple. Staging/production should use durable database/redis-backed storage where required by the deployment plan.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_CONNECTION=
SESSION_STORE=
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=null

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

BOOKING_HOLD_MINUTES=5
BOOKING_HOLD_MAX_TOTAL_MINUTES=15
BOOKING_HOLD_MAX_DURATION_MINUTES=240
RESERVATION_EXPIRE_GRACE_MINUTES=0
HOLD_RATE_LIMIT_PER_MINUTE=20
HOLD_RATE_LIMIT_WINDOW_SECONDS=60
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LOCK_SECONDS=120
IDEMPOTENCY_PENDING_SECONDS=300
IDEMPOTENCY_REQUIRED_FOR_RESERVATIONS=true
# Runtime gates always probe Redis for locks and scheduler heartbeat storage.
# Keep true in staging/production booking API environments unless an approved fallback is documented.
REQUIRE_REDIS_FOR_BOOKING_API=false
THROTTLE_TABLES_AVAILABLE_LIMIT=60
THROTTLE_TABLES_AVAILABLE_WINDOW=60
THROTTLE_TABLE_HOLDS_STORE_LIMIT=30
THROTTLE_TABLE_HOLDS_STORE_WINDOW=60
THROTTLE_RESERVATIONS_STORE_LIMIT=20
THROTTLE_RESERVATIONS_STORE_WINDOW=60
THROTTLE_RESERVATIONS_SHOW_LIMIT=120
THROTTLE_RESERVATIONS_SHOW_WINDOW=60
THROTTLE_RESERVATIONS_STATUS_LIMIT=30
THROTTLE_RESERVATIONS_STATUS_WINDOW=60
THROTTLE_STAFF_LIMIT=300
THROTTLE_STAFF_WINDOW=60

# Staff auth production safety.
# Production-like environments must use database-backed hashed staff_api_keys and keep env/role-name fallbacks disabled.
STAFF_AUTH_DATABASE_STORE_ENABLED=true
STAFF_AUTH_TOUCH_LAST_USED_AT=true
STAFF_AUTH_SESSION_TTL_MINUTES=30
STAFF_AUTH_BROWSER_SESSION_COOKIE_ENABLED=false
STAFF_AUTH_BROWSER_ACCESS_TTL_MINUTES=5
STAFF_AUTH_BROWSER_REFRESH_COOKIE=staff_web_refresh
STAFF_AUTH_BROWSER_REFRESH_COOKIE_PATH=/api/v1/auth/staff
STAFF_AUTH_BROWSER_REFRESH_COOKIE_DOMAIN=
STAFF_AUTH_BROWSER_CSRF_COOKIE=staff_web_csrf
STAFF_AUTH_BROWSER_CSRF_COOKIE_PATH=/
STAFF_AUTH_BROWSER_CSRF_COOKIE_DOMAIN=
STAFF_AUTH_BROWSER_CSRF_HEADER=X-Staff-CSRF
STAFF_AUTH_BROWSER_COOKIE_SAME_SITE=lax
STAFF_AUTH_BROWSER_COOKIE_SECURE=true
STAFF_AUTH_LOGIN_THROTTLE_LIMIT=10
STAFF_AUTH_LOGIN_THROTTLE_WINDOW_SECONDS=60
STAFF_API_KEYS_JSON={}
STAFF_API_KEY=
STAFF_API_KEY_USER_ID=0
STAFF_AUTH_ALLOW_BEARER=false
STAFF_AUTH_ALLOW_ENV_FALLBACK=false
STAFF_AUTH_ALLOW_ENV_FALLBACK_WHEN_DATABASE_STORE_UNAVAILABLE=false
STAFF_AUTH_ENV_FALLBACK_ALLOWED_ENVIRONMENTS=local,testing
STAFF_AUTH_PRODUCTION_LIKE_ENVIRONMENTS=production,staging,limited-production
STAFF_AUTH_DENY_ENV_FALLBACK_IN_PRODUCTION_LIKE=true
STAFF_AUTH_DENY_ROLE_NAME_FALLBACK_IN_PRODUCTION_LIKE=true
STAFF_AUTH_ALLOW_ROLE_NAME_FALLBACK=false
STAFF_ALLOWED_ROLE_IDS=1,2
STAFF_ALLOWED_ROLE_NAMES=Admin,Staff
CUSTOMER_AUTH_ENABLED=true
CUSTOMER_AUTH_HEADER=X-Customer-Token
CUSTOMER_AUTH_ALLOW_BEARER=true
CUSTOMER_AUTH_ACCESS_SESSION_TABLE=customer_access_sessions
CUSTOMER_AUTH_ACCESS_SESSION_TTL_MINUTES=20160
CUSTOMER_AUTH_TOUCH_LAST_USED_AT=true
CUSTOMER_AUTH_ALLOWED_PURPOSES=VerifyEmail,VerifyPhone
CUSTOMER_AUTH_REQUIRE_UNUSED=true
CUSTOMER_AUTH_ALLOW_LEGACY_USER_AUTH_TOKENS=false
CUSTOMER_AUTH_LEGACY_USER_AUTH_TOKENS_ALLOWED_ENVIRONMENTS=local,testing
CUSTOMER_AUTH_ALLOWED_ROLE_IDS=3
CUSTOMER_AUTH_DEFAULT_ROLE_ID=
CUSTOMER_AUTH_DEFAULT_ROLE_NAME=Customer
CUSTOMER_AUTH_JWT_ISSUER=${APP_URL}
CUSTOMER_AUTH_JWT_AUDIENCE=customer-api
# Customer JWT auth secret.
# Required before enabling customer JWT auth outside isolated local testing.
# Use a high-entropy secret and do not commit the real value.
CUSTOMER_AUTH_JWT_SECRET=
CUSTOMER_AUTH_JWT_ACCESS_TTL_MINUTES=15
CUSTOMER_AUTH_JWT_REFRESH_TTL_MINUTES=43200
CUSTOMER_AUTH_JWT_CLOCK_SKEW_SECONDS=30
CUSTOMER_AUTH_PASSWORD_RESET_TTL_MINUTES=60
CUSTOMER_AUTH_PASSWORD_RESET_DEBUG_EXPOSE_TOKEN=false
CUSTOMER_AUTH_PASSWORD_RESET_URL=
CUSTOMER_AUTH_LOGIN_THROTTLE_LIMIT=10
CUSTOMER_AUTH_LOGIN_THROTTLE_WINDOW_SECONDS=60
CUSTOMER_AUTH_REGISTER_THROTTLE_LIMIT=5
CUSTOMER_AUTH_REGISTER_THROTTLE_WINDOW_SECONDS=300
CUSTOMER_AUTH_REGISTER_PASSWORD_MIN_LENGTH=8
CUSTOMER_AUTH_PASSWORD_RESET_THROTTLE_LIMIT=5
CUSTOMER_AUTH_PASSWORD_RESET_THROTTLE_WINDOW_SECONDS=900
SCHEDULER_HEARTBEAT_TTL_SECONDS=300
SCHEDULER_HEARTBEAT_STALE_SECONDS=180
RESERVATION_LOCK_TTL_SECONDS=60
RESERVATION_LOCK_WAIT_SECONDS=10
RESERVATION_LOCK_PREFIX=booking:lock:table
RESERVATION_LOCK_RESERVATION_PREFIX=booking:lock:reservation
STAFF_CHECKIN_GRACE_MINUTES=15
RESERVATION_NO_SHOW_GRACE_MINUTES=15
SERVICE_BUFFER_MINUTES=0
BOOKING_CUSTOMER_PREORDER_MANAGEMENT_CUTOFF_MINUTES=60
BOOKING_CUSTOMER_RESERVATION_CANCELLATION_CUTOFF_MINUTES=30
BOOKING_CUSTOMER_RESERVATION_RESCHEDULE_CUTOFF_MINUTES=120
RESERVATION_CODE_PREFIX=RSV
RESERVATION_CODE_RANDOM_LEN=6
RESERVATION_CODE_MAX_ATTEMPTS=12
BOOKING_CUSTOMER_MENU_PAGE_DEFAULT=20
BOOKING_CUSTOMER_MENU_PAGE_MAX=100
BOOKING_CUSTOMER_RESERVATION_SELF_SERVICE_PAGE_DEFAULT=10
BOOKING_CUSTOMER_RESERVATION_SELF_SERVICE_PAGE_MAX=20
BOOKING_CUSTOMER_WAITING_LIST_PAGE_DEFAULT=20
BOOKING_CUSTOMER_WAITING_LIST_PAGE_MAX=100
PAYMENT_PROVIDER_DEFAULT=generic_http_hmac
CUSTOMER_DEPOSIT_PAYMENT_DEFAULT_PROVIDER=generic_http_hmac
CUSTOMER_BILL_PAYMENT_DEFAULT_PROVIDER=generic_http_hmac
PAYMENT_CUSTOMER_SELF_PAY_ENABLED=false
PAYMENT_PROVIDER_PRODUCTION_LIKE_ENVIRONMENTS=production,staging,limited-production
PAYMENT_PROVIDER_ALLOW_SIMULATED_IN_PRODUCTION_LIKE=false
CUSTOMER_DEPOSIT_PAYMENT_SIMULATED_SESSION_TTL_MINUTES=30
CUSTOMER_BILL_PAYMENT_SIMULATED_SESSION_TTL_MINUTES=30
PAYMENT_PROVIDER_WEBHOOK_SIGNATURE_HEADER=X-Payment-Signature
PAYMENT_PROVIDER_WEBHOOK_TIMESTAMP_HEADER=X-Payment-Timestamp

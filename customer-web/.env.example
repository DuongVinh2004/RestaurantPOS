# Backend origin only. The generated SDK appends /api/v1 route paths.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Dev-only diagnostics. Forced off when NODE_ENV=production.
NEXT_PUBLIC_SHOW_DEV_BACKEND_STATUS=true
NEXT_PUBLIC_ENABLE_DEV_MOCKS=false

# Wave 1 core surfaces.
NEXT_PUBLIC_FEATURE_MENU_CATEGORIES=true
NEXT_PUBLIC_FEATURE_MENU_ITEM_DETAIL=true
NEXT_PUBLIC_FEATURE_TABLE_AVAILABILITY=true
NEXT_PUBLIC_FEATURE_TABLE_HOLDS=true
NEXT_PUBLIC_FEATURE_PREORDER=true

# Wave 2 rollout-gated extras.
NEXT_PUBLIC_FEATURE_WAITING_LIST=false
NEXT_PUBLIC_FEATURE_ACCOUNT_BENEFITS=false
NEXT_PUBLIC_FEATURE_PRIVACY_TOOLS=false
NEXT_PUBLIC_FEATURE_DATA_EXPORT=false

# Live proof fixtures. Start customer-web separately on this exact origin before npm run test:e2e:live.
# Keep NEXT_PUBLIC_ENABLE_DEV_MOCKS=false for the live lane.
CUSTOMER_WEB_LIVE_APP_HOST=127.0.0.1
CUSTOMER_WEB_LIVE_APP_PORT=3000
CUSTOMER_WEB_LIVE_IDENTIFIER=
CUSTOMER_WEB_LIVE_PASSWORD=
CUSTOMER_WEB_LIVE_START_TIME=
CUSTOMER_WEB_LIVE_GUEST_NAME=Live Runtime Customer
CUSTOMER_WEB_LIVE_GUEST_PHONE=5550100
CUSTOMER_WEB_LIVE_GUEST_EMAIL=
CUSTOMER_WEB_LIVE_EXERCISE_DEPOSIT_PAYMENT_SESSION=false
CUSTOMER_WEB_LIVE_EXERCISE_BILL_PAYMENT_SESSION=false

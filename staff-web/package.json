{
  "name": "staff-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "encoding:check": "node ../scripts/ui-text-encoding-guard.mjs",
    "encoding:fix": "node ../scripts/ui-text-encoding-guard.mjs --write",
    "integrity:check": "node ../scripts/release/check-package-integrity.mjs --staff-web-only --root-dir=..",
    "preflight:local": "node ../scripts/ops/local-runtime-preflight.mjs",
    "dev": "vite",
    "build": "node ../scripts/ui-text-encoding-guard.mjs && npm run integrity:check && tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "node ../scripts/ui-text-encoding-guard.mjs && npm run integrity:check && vitest run src scripts/live-smoke.test.mjs scripts/local-runtime-preflight.test.mjs scripts/text-encoding-guard.test.mjs scripts/package-integrity.test.mjs",
    "smoke:live": "node scripts/live-smoke.mjs",
    "e2e:smoke": "npx playwright test --project=chromium",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.97.0",
    "antd": "^6.3.5",
    "lucide-react": "^0.368.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.4",
    "recharts": "^3.9.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.39",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^5.2.0",
    "vitest": "^2.1.9"
  }
}
